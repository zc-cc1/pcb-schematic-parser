<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第6周项目：引脚宽度、公差与OK/NG</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'ic_pin')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 设置算法参数变量 Sigma 的数值初值或阈值。</c>
<l>Sigma := 1.5</l><c>* [逐行] 设置算法参数变量 Threshold 的数值初值或阈值。</c>
<l>Threshold := 30</l><c>* [逐行] 设置算法参数变量 LowerLimit 的数值初值或阈值。</c>
<l>LowerLimit := 20.0</l><c>* [逐行] 设置算法参数变量 UpperLimit 的数值初值或阈值。</c>
<l>UpperLimit := 35.0</l><c>* [逐行] 把资源句柄变量 MeasureHandle 初始化为空元组，供后续收集结果。</c>
<l>MeasureHandle := []</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>Status := 'ERROR'</l><c>* [逐行] 设置行列坐标变量 StatusColor 的字符串值。</c>
<l>StatusColor := 'red'</l>
<c>* [逐行] 开始受保护代码块，运行错误将交给catch分支处理。</c>
<l>try</l><c>* [逐行] 创建矩形一维测量对象，并返回后续测量使用的句柄。</c>
<l>    gen_measure_rectangle2 (47,485,0,420,10,Width,Height,'nearest_neighbor',MeasureHandle)</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T0)</l><c>* [逐行] 沿测量矩形搜索成对边缘，并返回边缘位置、灰度幅度和宽度。</c>
<l>    measure_pairs (Image,MeasureHandle,Sigma,Threshold,'negative','all',RowFirst,ColumnFirst,AmpFirst,RowSecond,ColumnSecond,AmpSecond,PinWidth,PinDistance)</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T1)</l><c>* [逐行] 根据当前参数和中间结果计算布尔判定结果变量 ProcessingMs。</c>
<l>    ProcessingMs := (T1-T0)*1000.0</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (|PinWidth| &gt; 0)</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MeanWidth。</c>
<l>        MeanWidth := mean(PinWidth)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>        if (MeanWidth &gt;= LowerLimit and MeanWidth &lt;= UpperLimit)</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>            Status := 'OK'</l><c>* [逐行] 设置行列坐标变量 StatusColor 的字符串值。</c>
<l>            StatusColor := 'green'</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>        else</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>            Status := 'NG'</l><c>* [逐行] 设置行列坐标变量 StatusColor 的字符串值。</c>
<l>            StatusColor := 'red'</l><c>* [逐行] 结束当前条件分支。</c>
<l>        endif</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 设置几何尺寸变量 MeanWidth 的数值初值或阈值。</c>
<l>        MeanWidth := -1</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>        Status := 'NO_EDGES'</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 捕获try代码块抛出的HALCON异常，并保存异常元组。</c>
<l>catch (Exception)</l><c>* [逐行] 从捕获的异常中读取指定的错误信息字段。</c>
<l>    dev_get_exception_data (Exception,'error_msg',ErrorMessage)</l><c>* [逐行] 设置几何尺寸变量 MeanWidth 的数值初值或阈值。</c>
<l>    MeanWidth := -1</l><c>* [逐行] 设置布尔判定结果变量 ProcessingMs 的数值初值或阈值。</c>
<l>    ProcessingMs := -1</l><c>* [逐行] 结束异常处理代码块。</c>
<l>endtry</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (|MeasureHandle| &gt; 0)</l><c>* [逐行] 释放一维测量句柄，结束测量对象的生命周期。</c>
<l>    close_measure (MeasureHandle)</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width/2,Height/2,'black',WindowHandle)</l><c>* [逐行] 设置图像坐标与窗口显示区域的对应范围。</c>
<l>dev_set_part (0,0,Height-1,Width-1)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (Status == 'OK' or Status == 'NG')</l><c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>    gen_cross_contour_xld (Cross1,RowFirst,ColumnFirst,10,rad(45))</l><c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>    gen_cross_contour_xld (Cross2,RowSecond,ColumnSecond,10,rad(45))</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>    dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>    dev_display (Cross1)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>    dev_display (Cross2)</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['结果：' + Status,'平均宽度：' + MeanWidth$'.2f' + ' px','公差：' + LowerLimit + ' ... ' + UpperLimit + ' px','耗时：' + ProcessingMs$'.3f' + ' ms'], 'window',12,12,StatusColor,['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
