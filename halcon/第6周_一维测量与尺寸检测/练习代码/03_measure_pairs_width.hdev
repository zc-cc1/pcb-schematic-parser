<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第6周第3天：measure_pairs测量引脚宽度</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'ic_pin')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 设置行列坐标变量 Row 的数值初值或阈值。</c>
<l>Row := 47</l><c>* [逐行] 设置行列坐标变量 Column 的数值初值或阈值。</c>
<l>Column := 485</l><c>* [逐行] 设置方向角变量 Phi 的数值初值或阈值。</c>
<l>Phi := 0</l><c>* [逐行] 设置几何尺寸变量 Length1 的数值初值或阈值。</c>
<l>Length1 := 420</l><c>* [逐行] 设置几何尺寸变量 Length2 的数值初值或阈值。</c>
<l>Length2 := 10</l><c>* [逐行] 创建矩形一维测量对象，并返回后续测量使用的句柄。</c>
<l>gen_measure_rectangle2 (Row, Column, Phi, Length1, Length2, Width, Height, 'nearest_neighbor', MeasureHandle)</l><c>* [逐行] 沿测量矩形搜索成对边缘，并返回边缘位置、灰度幅度和宽度。</c>
<l>measure_pairs (Image, MeasureHandle, 1.5, 30, 'negative', 'all', RowFirst, ColumnFirst, AmpFirst, RowSecond, ColumnSecond, AmpSecond, PinWidth, PinDistance)</l><c>* [逐行] 释放一维测量句柄，结束测量对象的生命周期。</c>
<l>close_measure (MeasureHandle)</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MeanWidth。</c>
<l>MeanWidth := mean(PinWidth)</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MeanDistance。</c>
<l>MeanDistance := mean(PinDistance)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width/2,Height/2,'black',WindowHandle)</l><c>* [逐行] 设置图像坐标与窗口显示区域的对应范围。</c>
<l>dev_set_part (0,0,Height-1,Width-1)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>gen_cross_contour_xld (CrossFirst, RowFirst, ColumnFirst, 10, rad(45))</l><c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>gen_cross_contour_xld (CrossSecond, RowSecond, ColumnSecond, 10, rad(45))</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (CrossFirst)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (CrossSecond)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['边缘对数量：' + |PinWidth|,'平均宽度：' + MeanWidth$'.2f' + ' px','平均间距：' + MeanDistance$'.2f' + ' px'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
