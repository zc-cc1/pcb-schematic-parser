<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第6周第4天：基础二维几何</c><c>* [逐行] 设置行列坐标变量 RowP1 的数值初值或阈值。</c>
<l>RowP1 := 100</l><c>* [逐行] 设置行列坐标变量 ColP1 的数值初值或阈值。</c>
<l>ColP1 := 100</l><c>* [逐行] 设置行列坐标变量 RowP2 的数值初值或阈值。</c>
<l>RowP2 := 350</l><c>* [逐行] 设置行列坐标变量 ColP2 的数值初值或阈值。</c>
<l>ColP2 := 420</l><c>* [逐行] 计算两个点之间的欧氏距离。</c>
<l>distance_pp (RowP1, ColP1, RowP2, ColP2, PointDistance)</l>
<c>* [逐行] 设置行列坐标变量 RowL1 的数值初值或阈值。</c>
<l>RowL1 := 80</l><c>* [逐行] 设置行列坐标变量 ColL1 的数值初值或阈值。</c>
<l>ColL1 := 400</l><c>* [逐行] 设置行列坐标变量 RowL2 的数值初值或阈值。</c>
<l>RowL2 := 400</l><c>* [逐行] 设置行列坐标变量 ColL2 的数值初值或阈值。</c>
<l>ColL2 := 150</l><c>* [逐行] 计算点到直线的最短距离。</c>
<l>distance_pl (250, 250, RowL1, ColL1, RowL2, ColL2, PointLineDistance)</l>
<c>* [逐行] 计算两条无限直线的交点，并判断两线是否重合。</c>
<l>intersection_lines (80, 80, 420, 420, 80, 420, 420, 80, CrossRow, CrossColumn, IsOverlapping)</l><c>* [逐行] 计算两条直线之间的夹角。</c>
<l>angle_ll (80,80,420,420,80,420,420,80,Angle)</l>
<c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>gen_cross_contour_xld (Points, [RowP1,RowP2,250,CrossRow], [ColP1,ColP2,250,CrossColumn], 12, rad(45))</l><c>* [逐行] 根据一组行列坐标生成折线XLD轮廓。</c>
<l>gen_contour_polygon_xld (LineA, [80,420], [80,420])</l><c>* [逐行] 根据一组行列坐标生成折线XLD轮廓。</c>
<l>gen_contour_polygon_xld (LineB, [80,420], [420,80])</l>
<c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,550,500,'black',WindowHandle)</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (3)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (LineA)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (LineB)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Points)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['点点距离：' + PointDistance$'.2f','点线距离：' + PointLineDistance$'.2f','交点：' + CrossRow$'.2f' + ', ' + CrossColumn$'.2f','夹角：' + deg(Angle)$'.2f' + ' deg'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
