<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第6周第5天：30次重复性实验</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'ic_pin')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 创建矩形一维测量对象，并返回后续测量使用的句柄。</c>
<l>gen_measure_rectangle2 (47, 485, 0, 420, 10, Width, Height, 'nearest_neighbor', MeasureHandle)</l><c>* [逐行] 把几何尺寸变量 WidthMeans 初始化为空元组，供后续收集结果。</c>
<l>WidthMeans := []</l><c>* [逐行] 设置计数或索引变量 FailureCount 的数值初值或阈值。</c>
<l>FailureCount := 0</l>
<c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for RunIndex := 1 to 30 by 1</l><c>* [逐行] 向图像加入白噪声，用来模拟噪声干扰并进行压力测试。</c>
<l>    add_noise_white (Image, TestImage, 2.0)</l><c>* [逐行] 沿测量矩形搜索成对边缘，并返回边缘位置、灰度幅度和宽度。</c>
<l>    measure_pairs (TestImage, MeasureHandle, 1.5, 30, 'negative', 'all', RowFirst, ColumnFirst, AmpFirst, RowSecond, ColumnSecond, AmpSecond, Widths, Distances)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (|Widths| &gt; 0)</l><c>* [逐行] 把本次结果追加到几何尺寸变量 WidthMeans 中。</c>
<l>        WidthMeans := [WidthMeans,mean(Widths)]</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 把计数或索引变量 FailureCount 加1，记录一次新的事件。</c>
<l>        FailureCount := FailureCount + 1</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 释放一维测量句柄，结束测量对象的生命周期。</c>
<l>close_measure (MeasureHandle)</l>
<c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MeanWidth。</c>
<l>MeanWidth := mean(WidthMeans)</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MinWidth。</c>
<l>MinWidth := min(WidthMeans)</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MaxWidth。</c>
<l>MaxWidth := max(WidthMeans)</l><c>* [逐行] 根据当前参数和中间结果计算几何尺寸变量 StdWidth。</c>
<l>StdWidth := deviation(WidthMeans)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,620,480,'black',WindowHandle)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['30次重复性测试','有效次数：' + |WidthMeans|,'失败次数：' + FailureCount,'均值：' + MeanWidth$'.3f' + ' px','最小：' + MinWidth$'.3f','最大：' + MaxWidth$'.3f','标准差：' + StdWidth$'.4f'], 'window',35,35,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
