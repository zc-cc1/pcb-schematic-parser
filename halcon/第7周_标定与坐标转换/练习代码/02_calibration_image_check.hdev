<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第7周第2天：逐张检测标定板</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 生成面阵相机初始参数，并采用division畸变模型。</c>
<l>gen_cam_par_area_scan_division (0.008,0,0.0000086,0.0000086,384,288,768,576,StartCamPar)</l><c>* [逐行] 创建相机标定数据模型，用于保存相机、标定板和观测结果。</c>
<l>create_calib_data ('calibration_object',1,1,CalibDataID)</l><c>* [逐行] 向标定数据模型设置相机初始参数。</c>
<l>set_calib_data_cam_param (CalibDataID,0,[],StartCamPar)</l><c>* [逐行] 向标定数据模型设置标定板描述文件。</c>
<l>set_calib_data_calib_object (CalibDataID,0,'caltab_big.descr')</l><c>* [逐行] 设置计数或索引变量 SuccessCount 的数值初值或阈值。</c>
<l>SuccessCount := 0</l>
<c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 1 to 10 by 1</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>    read_image (Image,'calib/calib-3d-coord-' + I$'02d')</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (I == 1)</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>        get_image_size (Image,Width,Height)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>        dev_open_window (0,0,Width/2,Height/2,'black',WindowHandle)</l><c>* [逐行] 设置图像坐标与窗口显示区域的对应范围。</c>
<l>        dev_set_part (0,0,Height-1,Width-1)</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>    dev_display (Image)</l><c>* [逐行] 开始受保护代码块，运行错误将交给catch分支处理。</c>
<l>    try</l><c>* [逐行] 在当前图像中检测标定板，并把观测结果写入标定数据模型。</c>
<l>        find_calib_object (Image,CalibDataID,0,0,I-1,[],[])</l><c>* [逐行] 读取指定标定图中的标定板或标志点轮廓。</c>
<l>        get_calib_data_observ_contours (Caltab,CalibDataID,'caltab',0,0,I-1)</l><c>* [逐行] 读取指定标定图中的标定板或标志点轮廓。</c>
<l>        get_calib_data_observ_contours (Marks,CalibDataID,'marks',0,0,I-1)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>        dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>        dev_display (Caltab)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>        dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>        dev_display (Marks)</l><c>* [逐行] 把计数或索引变量 SuccessCount 加1，记录一次新的事件。</c>
<l>        SuccessCount := SuccessCount + 1</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>        Status := '检测成功'</l><c>* [逐行] 捕获try代码块抛出的HALCON异常，并保存异常元组。</c>
<l>    catch (Exception)</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>        Status := '检测失败'</l><c>* [逐行] 结束异常处理代码块。</c>
<l>    endtry</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>    disp_text (WindowHandle,['图像 ' + I + '/10',Status,'绿色：板轮廓；黄色：标志点'], 'window',12,12,'white',['box_color'],['black'])</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,'成功检测：' + SuccessCount + '/10', 'window',70,12,'cyan',['box_color'],['black'])</l><c>* [逐行] 释放标定数据模型句柄及其内部资源。</c>
<l>clear_calib_data (CalibDataID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
