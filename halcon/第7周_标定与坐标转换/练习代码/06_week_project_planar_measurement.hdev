<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第7周项目：标定、世界平面校正和尺寸验证</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 生成面阵相机初始参数，并采用division畸变模型。</c>
<l>gen_cam_par_area_scan_division (0.008,0,0.0000086,0.0000086,384,288,768,576,StartCamPar)</l><c>* [逐行] 创建相机标定数据模型，用于保存相机、标定板和观测结果。</c>
<l>create_calib_data ('calibration_object',1,1,CalibDataID)</l><c>* [逐行] 向标定数据模型设置相机初始参数。</c>
<l>set_calib_data_cam_param (CalibDataID,0,[],StartCamPar)</l><c>* [逐行] 向标定数据模型设置标定板描述文件。</c>
<l>set_calib_data_calib_object (CalibDataID,0,'caltab_big.descr')</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 1 to 10 by 1</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>    read_image (Image,'calib/calib-3d-coord-' + I$'02d')</l><c>* [逐行] 在当前图像中检测标定板，并把观测结果写入标定数据模型。</c>
<l>    find_calib_object (Image,CalibDataID,0,0,I-1,[],[])</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 根据已经采集的标定观测执行相机标定，并返回重投影误差。</c>
<l>calibrate_cameras (CalibDataID,Error)</l><c>* [逐行] 从标定数据模型读取相机参数、位姿或其他标定结果。</c>
<l>get_calib_data (CalibDataID,'camera',0,'params',CamParam)</l><c>* [逐行] 从标定数据模型读取相机参数、位姿或其他标定结果。</c>
<l>get_calib_data (CalibDataID,'calib_obj_pose',[0,0],'pose',Pose)</l><c>* [逐行] 读取标定图中检测到的图像点、索引和标定板位姿。</c>
<l>get_calib_data_observ_points (CalibDataID,0,0,0,Rows,Columns,Indices,ObservedPose)</l><c>* [逐行] 使用标定优化后的参考位姿进行世界坐标换算，ObservedPose仅保留作对比。</c>
<l>image_points_to_world_plane (CamParam,Pose,Rows,Columns,'mm',X,Y)</l><c>* [逐行] 把几何尺寸变量 Distances 初始化为空元组，供后续收集结果。</c>
<l>Distances := []</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for K := 0 to min2(4,|X|-2) by 1</l><c>* [逐行] 根据当前数据计算控制变量，并把结果保存到 D。</c>
<l>    D := sqrt((X[K+1]-X[K])*(X[K+1]-X[K]) + (Y[K+1]-Y[K])*(Y[K+1]-Y[K]))</l><c>* [逐行] 把本次结果追加到几何尺寸变量 Distances 中。</c>
<l>    Distances := [Distances,D]</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 根据当前数据计算几何尺寸，并把结果保存到 MeanDistance。</c>
<l>MeanDistance := mean(Distances)</l><c>* [逐行] 根据当前数据计算算法参数，并把结果保存到 MaxDeviation。</c>
<l>MaxDeviation := max(abs(Distances-MeanDistance))</l><c>* [逐行] 平移位姿原点，使世界平面校正使用新的参考原点。</c>
<l>set_origin_pose (Pose,-1.125,-1.0,0,PoseNewOrigin)</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (MeasurementImage,'calib/calib-3d-coord-01')</l><c>* [逐行] 依据相机参数和位姿把整幅图像校正到世界平面。</c>
<l>image_to_world_plane (MeasurementImage,WorldImage,CamParam,PoseNewOrigin,900,800,0.0025,'bilinear')</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,900,800,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (WorldImage)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['第7周项目完成','重投影误差：' + Error$'.4f' + ' pixel','相邻点平均距离：' + MeanDistance$'.3f' + ' mm','最大距离偏差：' + MaxDeviation$'.3f' + ' mm'], 'window',12,12,'white',['box_color'],['black'])</l><c>* [逐行] 释放标定数据模型句柄及其内部资源。</c>
<l>clear_calib_data (CalibDataID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
