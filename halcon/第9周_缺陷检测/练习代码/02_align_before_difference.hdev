<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第9周第2天：不对齐会产生大面积假缺陷</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Background,'byte',640,480)</l><c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (Part,120,100,360,540)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>paint_region (Part,Background,ReferenceImage,160,'fill')</l><c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>hom_mat2d_identity (Move)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>hom_mat2d_rotate (Move,rad(3),240,320,Move)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>hom_mat2d_translate (Move,8,-12,Move)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>affine_trans_image (ReferenceImage,MovedImage,Move,'constant','false')</l><c>* [逐行] 计算两幅图像对应像素的绝对灰度差，用于突出变化或缺陷。</c>
<l>abs_diff_image (ReferenceImage,MovedImage,DiffBefore,1)</l><c>* [逐行] 求二维变换矩阵的逆矩阵，用于撤销已有位姿变换。</c>
<l>hom_mat2d_invert (Move,InverseMove)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>affine_trans_image (MovedImage,AlignedImage,InverseMove,'constant','false')</l><c>* [逐行] 计算两幅图像对应像素的绝对灰度差，用于突出变化或缺陷。</c>
<l>abs_diff_image (ReferenceImage,AlignedImage,DiffAfter,1)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (DiffBefore,RegionBefore,20,255)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (DiffAfter,RegionAfter,20,255)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (RegionBefore,AreaBefore,Row1,Col1)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (RegionAfter,AreaAfter,Row2,Col2)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,480,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (DiffAfter)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (RegionBefore)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (RegionAfter)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['对齐前差异面积：' + AreaBefore$'.0f','对齐后差异面积：' + AreaAfter$'.0f','红色：对齐前；绿色：对齐后'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
