<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第9周项目：位姿变化、对齐、缺陷提取和混淆统计</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Background,'byte',640,480)</l><c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (Part,120,100,360,540)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>paint_region (Part,Background,ReferenceImage,160,'fill')</l><c>* [逐行] 设置混淆矩阵计数变量 TP 的数值初值或阈值。</c>
<l>TP := 0</l><c>* [逐行] 设置混淆矩阵计数变量 TN 的数值初值或阈值。</c>
<l>TN := 0</l><c>* [逐行] 设置混淆矩阵计数变量 FP 的数值初值或阈值。</c>
<l>FP := 0</l><c>* [逐行] 设置混淆矩阵计数变量 FN 的数值初值或阈值。</c>
<l>FN := 0</l><c>* [逐行] 把面积特征变量 Areas 初始化为空元组，供后续收集结果。</c>
<l>Areas := []</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 0 to 39 by 1</l><c>* [逐行] 计算判断条件，并把真假结果保存到 GroundTruthNG。</c>
<l>    GroundTruthNG := I%3 == 0</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (GroundTruthNG)</l><c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>        gen_circle (Defect,210+(I%4)*18,250+(I%6)*30,7+(I%5)*3)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>        paint_region (Defect,ReferenceImage,SourceImage,35,'fill')</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 复制指定图形对象，得到独立的输出对象引用。</c>
<l>        copy_obj (ReferenceImage,SourceImage,1,1)</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>    hom_mat2d_identity (Move)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>    hom_mat2d_rotate (Move,rad((I%7-3)*1.2),240,320,Move)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>    hom_mat2d_translate (Move,(I%5-2)*3,(I%6-3)*3,Move)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>    affine_trans_image (SourceImage,MovedImage,Move,'constant','false')</l><c>* [逐行] 求二维变换矩阵的逆矩阵，用于撤销已有位姿变换。</c>
<l>    hom_mat2d_invert (Move,InverseMove)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>    affine_trans_image (MovedImage,AlignedImage,InverseMove,'constant','false')</l><c>* [逐行] 计算两幅图像对应像素的绝对灰度差，用于突出变化或缺陷。</c>
<l>    abs_diff_image (ReferenceImage,AlignedImage,DiffImage,1)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>    threshold (DiffImage,Candidates,45,255)</l><c>* [逐行] 使用圆形结构元素做开运算，以去除小区域和细小连接。</c>
<l>    opening_circle (Candidates,CandidatesOpened,1.5)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>    connection (CandidatesOpened,Connected)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>    select_shape (Connected,Defects,'area','and',50,99999)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>    area_center (Defects,DefectAreas,Rows,Columns)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (|DefectAreas| &gt; 0)</l><c>* [逐行] 根据当前数据计算面积特征，并把结果保存到 TotalDefectArea。</c>
<l>        TotalDefectArea := sum(DefectAreas)</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 设置面积特征变量 TotalDefectArea 的数值初值或阈值。</c>
<l>        TotalDefectArea := 0</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 把本次结果追加到面积特征变量 Areas 中。</c>
<l>    Areas := [Areas,TotalDefectArea]</l><c>* [逐行] 计算判断条件，并把真假结果保存到 PredictedNG。</c>
<l>    PredictedNG := TotalDefectArea &gt;= 120</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (GroundTruthNG and PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 TP 加1，记录一次新的事件。</c>
<l>        TP := TP+1</l><c>* [逐行] 前一条件不成立时继续判断这个补充条件。</c>
<l>    elseif (not GroundTruthNG and not PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 TN 加1，记录一次新的事件。</c>
<l>        TN := TN+1</l><c>* [逐行] 前一条件不成立时继续判断这个补充条件。</c>
<l>    elseif (not GroundTruthNG and PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 FP 加1，记录一次新的事件。</c>
<l>        FP := FP+1</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 把混淆矩阵计数变量 FN 加1，记录一次新的事件。</c>
<l>        FN := FN+1</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,480,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (AlignedImage)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Defects)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['第9周项目：40张','TP=' + TP + '  TN=' + TN,'FP误检=' + FP + '  FN漏检=' + FN,'最后一张缺陷总面积=' + TotalDefectArea$'.0f','红色：最后一张缺陷候选'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
