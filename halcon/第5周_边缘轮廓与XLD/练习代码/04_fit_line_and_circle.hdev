<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第5周第4天：直线与圆拟合</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l>
<c>* [逐行] 设置行列坐标变量 Rows 的元组数据，供后续批量处理。</c>
<l>Rows := [80,120,160,200,240,280,320,360]</l><c>* [逐行] 设置行列坐标变量 Cols 的元组数据，供后续批量处理。</c>
<l>Cols := [100,140,181,220,261,300,339,380]</l><c>* [逐行] 根据一组行列坐标生成折线XLD轮廓。</c>
<l>gen_contour_polygon_xld (LineSamples, Rows, Cols)</l><c>* [逐行] 用XLD轮廓点拟合直线，并输出直线端点和方向。</c>
<l>fit_line_contour_xld (LineSamples, 'tukey', -1, 0, 5, 2, RowBegin, ColBegin, RowEnd, ColEnd, Nr, Nc, Dist)</l><c>* [逐行] 根据一组行列坐标生成折线XLD轮廓。</c>
<l>gen_contour_polygon_xld (FittedLine, [RowBegin,RowEnd], [ColBegin,ColEnd])</l>
<c>* [逐行] 根据圆心、半径和角度范围生成圆弧XLD轮廓。</c>
<l>gen_circle_contour_xld (CircleSamples, 280, 420, 90, rad(20), rad(330), 'positive', 2)</l><c>* [逐行] 用XLD轮廓点拟合圆，并输出圆心、半径及轮廓端点。</c>
<l>fit_circle_contour_xld (CircleSamples, 'ahuber', -1, 2, 0, 3, 2, CircleRow, CircleColumn, Radius, StartPhi, EndPhi, PointOrder)</l><c>* [逐行] 根据圆心、半径和角度范围生成圆弧XLD轮廓。</c>
<l>gen_circle_contour_xld (FittedCircle, CircleRow, CircleColumn, Radius, 0, rad(360), 'positive', 1)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,650,520,'black',WindowHandle)</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (4)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('white')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (LineSamples)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (CircleSamples)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (FittedLine)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (FittedCircle)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['白：输入轮廓点','绿：拟合结果','圆心：' + CircleRow$'.2f' + ', ' + CircleColumn$'.2f','半径：' + Radius$'.2f','直线法向：' + Nr$'.3f' + ', ' + Nc$'.3f','Dist：' + Dist$'.3f'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
