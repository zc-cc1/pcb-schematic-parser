<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第5周第3天：轮廓分割与筛选</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'double_circle')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 以亚像素精度提取图像边缘，输出XLD轮廓。</c>
<l>edges_sub_pix (Image, Edges, 'canny', 2, 20, 60)</l><c>* [逐行] 把XLD轮廓按直线或圆弧结构分段。</c>
<l>segment_contours_xld (Edges, Split, 'lines_circles', 5, 4, 3)</l><c>* [逐行] 根据长度等轮廓特征筛选XLD轮廓。</c>
<l>select_contours_xld (Split, LongContours, 'contour_length', 40, 99999, -0.5, 0.5)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (Edges, CountRaw)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (Split, CountSplit)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (LongContours, CountSelected)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置多对象循环配色方式，便于区分不同区域或轮廓。</c>
<l>dev_set_colored (12)</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (3)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Split)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['分割后片段：' + CountSplit,'不同颜色表示不同XLD对象'], 'window',12,12,'white',['box_color'],['black'])</l><c>* [逐行] 暂停程序，便于在HDevelop中观察当前中间结果。</c>
<l>stop ()</l>
<c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (LongContours)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['长度筛选后：' + CountSelected,'短噪声轮廓被排除'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
