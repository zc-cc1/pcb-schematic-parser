<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第5周第1天：Region边界与XLD</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'rings_and_nuts')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (Image, Region, 0, 100)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>connection (Region, Connected)</l><c>* [逐行] 使用标准形状条件筛选区域，例如保留最大区域。</c>
<l>select_shape_std (Connected, Selected, 'max_area', 70)</l><c>* [逐行] 提取区域边界，得到只表示边缘的区域对象。</c>
<l>boundary (Selected, RegionBoundary, 'inner')</l><c>* [逐行] 把区域边界转换为XLD轮廓。</c>
<l>gen_contour_region_xld (Selected, RegionContourXLD, 'border')</l><c>* [逐行] 以亚像素精度提取图像边缘，输出XLD轮廓。</c>
<l>edges_sub_pix (Image, SubPixelEdges, 'canny', 1.2, 20, 40)</l>
<c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (RegionBoundary, NumRegionObjects)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (SubPixelEdges, NumXLDObjects)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,720,540,'black',WindowHandle)</l><c>* [逐行] 设置图像坐标与窗口显示区域的对应范围。</c>
<l>dev_set_part (0,0,Height-1,Width-1)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (3)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (RegionBoundary)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['黄色：Region像素边界','Region适合面积、连通性和形态学'], 'window', 12,12,'white',['box_color'],['black'])</l><c>* [逐行] 暂停程序，便于在HDevelop中观察当前中间结果。</c>
<l>stop ()</l>
<c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (SubPixelEdges)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['绿色：edges_sub_pix得到的XLD','XLD点坐标可为小数，适合拟合与精密几何'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
