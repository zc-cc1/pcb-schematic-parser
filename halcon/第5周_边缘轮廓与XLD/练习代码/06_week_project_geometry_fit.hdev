<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第5周项目：从真实图像提取圆弧并拟合</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image, 'double_circle')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* [逐行] 以亚像素精度提取图像边缘，输出XLD轮廓。</c>
<l>edges_sub_pix (Image, Edges, 'canny', 2, 20, 60)</l><c>* [逐行] 把XLD轮廓按直线或圆弧结构分段。</c>
<l>segment_contours_xld (Edges, Split, 'lines_circles', 5, 4, 3)</l><c>* [逐行] 根据长度等轮廓特征筛选XLD轮廓。</c>
<l>select_contours_xld (Split, Candidates, 'contour_length', 40, 99999, -0.5, 0.5)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (Candidates, NumCandidates)</l><c>* [逐行] 创建空的图形对象，作为无结果状态或对象收集器的初值。</c>
<l>gen_empty_obj (FittedCircles)</l><c>* [逐行] 把几何尺寸变量 Radii 初始化为空元组，供后续收集结果。</c>
<l>Radii := []</l>
<c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for Index := 1 to NumCandidates by 1</l><c>* [逐行] 从对象数组中取出指定序号的单个图形对象。</c>
<l>    select_obj (Candidates, Candidate, Index)</l><c>* [逐行] 读取XLD轮廓的全局属性。</c>
<l>    get_contour_global_attrib_xld (Candidate, 'cont_approx', ApproxType)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (ApproxType &gt; 0)</l><c>* [逐行] 用XLD轮廓点拟合圆，并输出圆心、半径及轮廓端点。</c>
<l>        fit_circle_contour_xld (Candidate, 'ahuber', -1, 2, 0, 3, 2, Row, Column, Radius, StartPhi, EndPhi, PointOrder)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>        if (Radius &gt; 10 and Radius &lt; 500)</l><c>* [逐行] 根据圆心、半径和角度范围生成圆弧XLD轮廓。</c>
<l>            gen_circle_contour_xld (Circle, Row, Column, Radius, 0, rad(360), 'positive', 1)</l><c>* [逐行] 把当前图形对象追加到对象数组中。</c>
<l>            concat_obj (FittedCircles, Circle, FittedCircles)</l><c>* [逐行] 把本次结果追加到几何尺寸变量 Radii 中。</c>
<l>            Radii := [Radii,Radius]</l><c>* [逐行] 结束当前条件分支。</c>
<l>        endif</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (3)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Candidates)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (FittedCircles)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['黄色：候选轮廓','绿色：有效圆拟合','有效半径数量：' + |Radii|,'半径：' + Radii$'.2f'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
