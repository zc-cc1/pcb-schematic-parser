<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第2天：图标变量和控制变量</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<c>* Image 和 ROI、ImageReduced 是图标变量</c>
<l>read_image (Image, 'fabrik')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>gen_rectangle1 (ROI, 150, 150, 350, 350)</l>
<l>reduce_domain (Image, ROI, ImageReduced)</l>
<l>get_image_size(ImageReduced,rewidth,reheight)</l>
<c>* 下列变量是控制变量</c>
<l>ImageNames := ['fabrik', 'clip', 'monkey','rings_and_nuts']</l>
<l>tuple_length (ImageNames, NumberOfImages)</l>
<l>CourseName := 'HALCON基础'</l>
<l>DayNumber := 2</l>
<l>dev_open_window (0, 0, 640, 480, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_color ('yellow')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (ROI)</l>
<l>InfoText := [CourseName, '第 ' + DayNumber + ' 天', '图片元组长度：' + NumberOfImages]</l>
<l>disp_text (WindowHandle, InfoText, 'window', 12, 12, 'white', [], [])</l>
<c>* 在变量窗口分别双击 Image、ROI、ImageReduced</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
