<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第4天：图形窗口和结果叠加</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'rings_and_nuts')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>gen_rectangle1 (RectangleROI, 40, 50, 220, 300)</l>
<l>gen_circle (CircleROI, 300, 420, 80)</l>
<l>dev_open_window (0, 0, 720, 540, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('fill')</l>
<l>dev_set_line_width (4)</l>
<l>dev_set_color ('blue')</l>
<l>dev_display (RectangleROI)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (CircleROI)</l>
<l>disp_text (WindowHandle, ['绿色：矩形ROI', '红色：圆形ROI', '显示参数不会修改原图'], 'window', 12, 12, 'white', [], [])</l>
<c>* 练习：修改颜色、线宽，并把 margin 改成 fill</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
