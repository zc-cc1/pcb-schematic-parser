<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第3天：元组、循环和条件判断</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>ImageNames := ['fabrik', 'clip', 'monkey','rings_and_nuts']</l>
<l>dev_open_window (0, 0, 640, 480, 'black', WindowHandle)</l>
<l>landscapecount :=0</l>
<l>portraitcount :=0</l>
<l>squarecount := 0</l>
<l>for ImageIndex := 0 to |ImageNames| - 1 by 1</l>
<l>    read_image (Image, ImageNames[ImageIndex])</l>
<l>    get_image_size (Image, Width, Height)</l>
<l>    landscapecount := landscapecount + 1</l>
<l>    portraitcount := portraitcount +1</l>
<l>    if (Width &gt; Height)</l>
<l>        Orientation := '横向图像'</l>
<l>    elseif (Width &lt; Height)</l>
<l>        Orientation := '竖向图像'</l>
<l>    else</l>
<l>        Orientation := '方形图像'</l>
<l>    endif</l>
<l>    dev_set_part(0, 0, Height - 1, Width - 1)</l>
<l>    dev_display (Image)</l>
<l>    InfoText := ['序号：' + (ImageIndex + 1) + ' / ' + |ImageNames|, '图片：' + ImageNames[ImageIndex], '尺寸：' + Width + ' x ' + Height, Orientation]</l>
<l>    disp_text (WindowHandle, InfoText, 'window', 12, 12, 'white', [], [])</l>
<l>    stop ()</l>
<l>endfor</l>
<c>* 练习：增加第4张图，并统计横向图像数量</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
