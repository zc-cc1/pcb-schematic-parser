<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第10周第3天：点阵字符分割</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image,'needle1')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image,Width,Height)</l><c>* [逐行] 设置行列坐标变量 Row1 的数值初值或阈值。</c>
<l>Row1 := 50</l><c>* [逐行] 设置行列坐标变量 Column1 的数值初值或阈值。</c>
<l>Column1 := 90</l><c>* [逐行] 设置行列坐标变量 Row2 的数值初值或阈值。</c>
<l>Row2 := 250</l><c>* [逐行] 设置行列坐标变量 Column2 的数值初值或阈值。</c>
<l>Column2 := 370</l><c>* [逐行] 根据当前参数和中间结果计算控制变量变量 Px。</c>
<l>Px := (Column1+Column2)/2</l><c>* [逐行] 根据当前参数和中间结果计算控制变量变量 Py。</c>
<l>Py := (Row1+Row2)/2</l><c>* [逐行] 估计文本行方向，供后续旋转校正使用。</c>
<l>text_line_orientation (Image,Image,35,rad(-30),rad(30),OrientationAngle)</l><c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>hom_mat2d_identity (HomMat2D)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>hom_mat2d_rotate (HomMat2D,-OrientationAngle,Px,Py,HomMat2D)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>affine_trans_image (Image,Rotated,HomMat2D,'constant','false')</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (Rotated,RawSegmentation,0,105)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>connection (RawSegmentation,ConnectedRegions)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>select_shape (ConnectedRegions,MinSizeRegions,'area','and',6,99999)</l><c>* [逐行] 把对象数组中的所有区域合并为一个区域。</c>
<l>union1 (MinSizeRegions,RemovedNoise)</l><c>* [逐行] 把区域裁剪到指定矩形范围，去除ROI以外的部分。</c>
<l>clip_region (RemovedNoise,RawSegmentation,53,75,260,356)</l><c>* [逐行] 使用圆形结构元素做闭运算，以连接小间隙并填补小孔。</c>
<l>closing_circle (RawSegmentation,ClosedPatterns,6)</l><c>* [逐行] 使用矩形结构元素做开运算，按指定方向分离或去除结构。</c>
<l>opening_rectangle1 (ClosedPatterns,SplitPatterns,1,5)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>connection (SplitPatterns,ConnPatterns)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>select_shape (ConnPatterns,CharCandidates,'area','and',150,5999)</l><c>* [逐行] 把区域转换成指定标准外形，例如最小外接矩形。</c>
<l>shape_trans (CharCandidates,CharBlocks,'rectangle1')</l><c>* [逐行] 按照给定字符宽高把矩形区域切分成多个候选区域。</c>
<l>partition_rectangle (CharBlocks,Partitioned,25,100)</l><c>* [逐行] 计算两个区域的交集，只保留二者共同覆盖的部分。</c>
<l>intersection (Partitioned,RawSegmentation,Characters)</l><c>* [逐行] 使用圆形结构元素做闭运算，以连接小间隙并填补小孔。</c>
<l>closing_circle (Characters,IntermedCharacters,2.5)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>select_shape (IntermedCharacters,FinalCandidates,'height','and',24,50)</l><c>* [逐行] 按字符阅读顺序对区域排序，保证OCR输出顺序正确。</c>
<l>sort_region (FinalCandidates,FinalCharacters,'character','true','row')</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>count_obj (FinalCharacters,CharacterCount)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width*2,Height*2,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Rotated)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (3)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (FinalCharacters)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['分割字符数：' + CharacterCount,'绿色：送入OCR分类器的字符区域'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
