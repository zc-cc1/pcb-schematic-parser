<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第10周第5天：识别成功后还要做业务格式校验</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 设置文本或标识信息变量 DecodedStrings 的元组数据，供后续批量处理。</c>
<l>DecodedStrings := ['SN-20260812-A15','SN-20260812-?15','ABC123','SN-20261340-Z99']</l><c>* [逐行] 把布尔判定结果变量 FormatOK 初始化为空元组，供后续收集结果。</c>
<l>FormatOK := []</l><c>* [逐行] 把检测状态变量 Status 初始化为空元组，供后续收集结果。</c>
<l>Status := []</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 0 to |DecodedStrings|-1 by 1</l><c>* [逐行] 使用正则表达式检查字符串格式是否满足业务规则。</c>
<l>    tuple_regexp_test (DecodedStrings[I],'^SN-[0-9]{8}-[A-Z][0-9]{2}$',RegexOK)</l><c>* [逐行] 把本次结果追加到布尔判定结果变量 FormatOK 中。</c>
<l>    FormatOK := [FormatOK,RegexOK]</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (RegexOK)</l><c>* [逐行] 把本次结果追加到检测状态变量 Status 中。</c>
<l>        Status := [Status,'格式通过']</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 把本次结果追加到检测状态变量 Status 中。</c>
<l>        Status := [Status,'格式异常']</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Image,'byte',640,360)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,360,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['原始识别结果：',DecodedStrings,'正则：^SN-[0-9]{8}-[A-Z][0-9]{2}$','结果：',Status], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
