<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第三周第5天：亮度压力测试与统计（每行代码的下一行是功能讲解）</c>
<l>dev_update_off ()</l>
<c>* 关闭 HDevelop 自动刷新，避免逐行重绘影响压力测试的算法计时。</c>
<l>dev_close_window ()</l>
<c>* 关闭此前由 HDevelop 管理的所有图形窗口，为测试建立干净的显示环境。</c>
<l>read_image (Image, 'rings_and_nuts')</l>
<c>* 读取包含七个真实零件的标准图像，后续所有测试条件都由该图生成。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* 获取原图宽度和高度，用于创建局部阴影区域以及设置图形窗口。</c>
<l>scale_image (Image, ImageDark35, 0.35, 0)</l>
<c>* 将全图灰度乘以 0.35，生成严重整体变暗的测试图，模拟欠曝或光源衰减。</c>
<l>scale_image (Image, ImageDark55, 0.55, 0)</l>
<c>* 将全图灰度乘以 0.55，生成中等程度整体变暗的测试图。</c>
<l>scale_image (Image, ImageBright, 1.20, 0)</l>
<c>* 将全图灰度乘以 1.20 并裁剪到 byte 范围，生成整体变亮的测试图。</c>
<l>gen_rectangle1 (ShadowROI, 0, 0, Height - 1, Width / 3)</l>
<c>* 创建覆盖图像左侧约三分之一宽度的矩形区域，用它限定局部阴影位置。</c>
<l>reduce_domain (Image, ShadowROI, ShadowSource)</l>
<c>* 将原图定义域限制到阴影矩形内，使后续变暗操作只对左侧区域有效。</c>
<l>scale_image (ShadowSource, ShadowDarkPart, 0.50, 0)</l>
<c>* 将左侧区域灰度乘以 0.50，生成需要覆盖回原图的局部暗化图像。</c>
<l>paint_gray (ShadowDarkPart, Image, ImageLocalShadow)</l>
<c>* 只把 ShadowDarkPart 定义域内的暗化灰度写入原图副本，形成左侧局部阴影。</c>
<l>sp_distribution (1, 1, NoiseDistribution)</l>
<c>* 生成含 1% 盐噪声和 1% 椒噪声的概率分布，盐为极亮点、椒为极暗点。</c>
<l>add_noise_distribution (Image, ImageNoise, NoiseDistribution)</l>
<c>* 按上述分布向原图随机加入椒盐噪声，生成噪声压力测试图。</c>
<l>concat_obj (Image, ImageDark35, TestImages)</l>
<c>* 将原图和严重变暗图连接成图像对象数组 TestImages 的前两个元素。</c>
<l>concat_obj (TestImages, ImageDark55, TestImages)</l>
<c>* 把中等变暗图追加到测试图像对象数组。</c>
<l>concat_obj (TestImages, ImageBright, TestImages)</l>
<c>* 把整体变亮图追加到测试图像对象数组。</c>
<l>concat_obj (TestImages, ImageLocalShadow, TestImages)</l>
<c>* 把局部阴影图追加到测试图像对象数组。</c>
<l>concat_obj (TestImages, ImageNoise, TestImages)</l>
<c>* 把椒盐噪声图追加到测试图像对象数组，最终形成六组测试条件。</c>
<l>ConditionNames := ['原图','整体变暗 0.35','整体变暗 0.55','整体变亮 1.20','左侧局部阴影 0.50','椒盐噪声 1%+1%']</l>
<c>* 建立与六幅测试图一一对应的条件名称元组，用于显示和记录测试结果。</c>
<l>ConditionCount := |ConditionNames|</l>
<c>* 读取条件名称元组长度作为测试条件数量，避免在循环中写死数字六。</c>
<l>ExpectedCount := 7</l>
<c>* 设置每幅测试图的真实目标数量为七个，检测结果将与该真值比较。</c>
<l>FixedThresholdMax := 130</l>
<c>* 冻结固定阈值上限为 130，六幅图都使用相同阈值，不允许逐图调参。</c>
<l>MeanMask := 151</l>
<c>* 冻结动态阈值参考图的均值滤波掩膜为 151×151，使其大于大部分目标尺寸。</c>
<l>DynOffset := 15</l>
<c>* 冻结动态阈值灰度差为 15，像素至少比局部参考背景暗 15 才会入选。</c>
<l>FixedCounts := []</l>
<c>* 初始化固定阈值检测数量元组，循环中每处理一幅图就追加一个结果。</c>
<l>DynCounts := []</l>
<c>* 初始化动态阈值检测数量元组。</c>
<l>FixedTimesMs := []</l>
<c>* 初始化固定阈值流程耗时元组，单位将在循环中转换为毫秒。</c>
<l>DynTimesMs := []</l>
<c>* 初始化动态阈值流程耗时元组。</c>
<l>FixedCorrectCount := 0</l>
<c>* 初始化固定阈值计数正确的测试条件数量。</c>
<l>DynCorrectCount := 0</l>
<c>* 初始化动态阈值计数正确的测试条件数量。</c>
<l>dev_open_window (0, 0, Width, Height, 'black', WindowHandle)</l>
<c>* 打开与原图尺寸相同的图形窗口，并保存窗口句柄以显示每组测试结果。</c>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<c>* 将窗口显示坐标映射到完整图像范围，使区域轮廓与原图坐标准确重合。</c>
<l>dev_set_draw ('margin')</l>
<c>* 将区域显示方式设为轮廓，防止两种方法的填充颜色完全遮挡图像内容。</c>
<l>dev_set_line_width (3)</l>
<c>* 将检测结果轮廓线宽设为三个像素，方便观察两种方法的差异。</c>
<l>for Index := 1 to ConditionCount by 1</l>
<c>* 依次遍历六组测试图像，对每一组运行完全相同的固定阈值和动态阈值流程。</c>
<l>    select_obj (TestImages, TestImage, Index)</l>
<c>* 根据当前索引从图像对象数组中取出一幅测试图。</c>
<l>    count_seconds (TimeStart)</l>
<c>* 记录固定阈值流程开始时间；图形显示和人工暂停不包含在该计时内。</c>
<l>    threshold (TestImage, FixedRegion, 0, FixedThresholdMax)</l>
<c>* 使用冻结的 0～130 灰度范围选取暗像素，得到固定阈值候选区域。</c>
<l>    connection (FixedRegion, FixedConnected)</l>
<c>* 将固定阈值候选区域按像素连通关系拆成独立连通域。</c>
<l>    select_shape (FixedConnected, FixedParts, ['width','height'], 'and', [50,50], [130,130])</l>
<c>* 使用冻结的宽高范围排除顶部边界、整片背景和微小椒噪声，保留零件尺寸候选。</c>
<l>    count_obj (FixedParts, FixedCount)</l>
<c>* 统计固定阈值流程在当前测试图中得到的候选零件数量。</c>
<l>    count_seconds (TimeEnd)</l>
<c>* 记录固定阈值流程结束时间。</c>
<l>    FixedTimeMs := (TimeEnd - TimeStart) * 1000.0</l>
<c>* 计算固定阈值完整流程耗时并从秒转换为毫秒。</c>
<l>    count_seconds (TimeStart)</l>
<c>* 记录动态阈值流程开始时间。</c>
<l>    mean_image (TestImage, MeanImage, MeanMask, MeanMask)</l>
<c>* 使用 151×151 均值滤波生成当前测试图的局部背景参考图。</c>
<l>    dyn_threshold (TestImage, MeanImage, DynRegion, DynOffset, 'dark')</l>
<c>* 选择比各自局部参考背景至少暗 15 的像素，得到动态阈值候选区域。</c>
<l>    connection (DynRegion, DynConnected)</l>
<c>* 将动态阈值候选区域拆成独立连通域。</c>
<l>    select_shape (DynConnected, DynParts, ['width','height'], 'and', [50,50], [130,130])</l>
<c>* 使用与固定阈值流程相同的宽高范围筛选动态阈值候选区域，保证比较公平。</c>
<l>    count_obj (DynParts, DynCount)</l>
<c>* 统计动态阈值流程在当前测试图中得到的候选零件数量。</c>
<l>    count_seconds (TimeEnd)</l>
<c>* 记录动态阈值流程结束时间。</c>
<l>    DynTimeMs := (TimeEnd - TimeStart) * 1000.0</l>
<c>* 计算包含均值滤波在内的动态阈值完整流程耗时，单位为毫秒。</c>
<l>    FixedCounts := [FixedCounts,FixedCount]</l>
<c>* 把当前固定阈值检测数量追加到汇总元组末尾。</c>
<l>    DynCounts := [DynCounts,DynCount]</l>
<c>* 把当前动态阈值检测数量追加到汇总元组末尾。</c>
<l>    FixedTimesMs := [FixedTimesMs,FixedTimeMs]</l>
<c>* 把当前固定阈值流程耗时追加到耗时汇总元组。</c>
<l>    DynTimesMs := [DynTimesMs,DynTimeMs]</l>
<c>* 把当前动态阈值流程耗时追加到耗时汇总元组。</c>
<l>    FixedStatus := 'FAIL'</l>
<c>* 默认将当前固定阈值结果标记为失败，只有数量等于真值时才改为通过。</c>
<l>    if (FixedCount == ExpectedCount)</l>
<c>* 判断固定阈值检测数量是否等于七个。</c>
<l>        FixedCorrectCount := FixedCorrectCount + 1</l>
<c>* 如果计数正确，则固定阈值正确条件数增加一。</c>
<l>        FixedStatus := 'PASS'</l>
<c>* 将当前固定阈值状态修改为通过。</c>
<l>    endif</l>
<c>* 结束固定阈值计数是否正确的条件判断。</c>
<l>    DynStatus := 'FAIL'</l>
<c>* 默认将当前动态阈值结果标记为失败。</c>
<l>    if (DynCount == ExpectedCount)</l>
<c>* 判断动态阈值检测数量是否等于七个。</c>
<l>        DynCorrectCount := DynCorrectCount + 1</l>
<c>* 如果计数正确，则动态阈值正确条件数增加一。</c>
<l>        DynStatus := 'PASS'</l>
<c>* 将当前动态阈值状态修改为通过。</c>
<l>    endif</l>
<c>* 结束动态阈值计数是否正确的条件判断。</c>
<l>    dev_display (TestImage)</l>
<c>* 显示当前测试图，作为两种检测结果轮廓的共同背景。</c>
<l>    dev_set_color ('red')</l>
<c>* 将固定阈值检测结果的显示颜色设置为红色。</c>
<l>    dev_display (FixedParts)</l>
<c>* 在当前测试图上叠加固定阈值筛选后的候选零件轮廓。</c>
<l>    dev_set_color ('green')</l>
<c>* 将动态阈值检测结果的显示颜色设置为绿色。</c>
<l>    dev_display (DynParts)</l>
<c>* 在同一画面叠加动态阈值筛选结果；两种方法重合处绿色可能覆盖红色。</c>
<l>    ResultText := ['条件 ' + Index + '/' + ConditionCount + '：' + ConditionNames[Index - 1], '真实数量：' + ExpectedCount, '红色固定阈值：' + FixedCount + '，' + FixedStatus + '，' + FixedTimeMs$'.3f' + ' ms', '绿色动态阈值：' + DynCount + '，' + DynStatus + '，' + DynTimeMs$'.3f' + ' ms']</l>
<c>* 组织当前条件名称、真实数量、两种检测数量、状态和耗时的显示文本。</c>
<l>    disp_text (WindowHandle, ResultText, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 将当前测试结果显示在窗口左上角，供逐条件观察和记录。</c>
<l>    stop ()</l>
<c>* 暂停程序，让学习者检查当前条件下的误检和漏检；按 F5 后进入下一条件。</c>
<l>endfor</l>
<c>* 结束六组压力测试循环，此时数量和耗时结果已全部写入汇总元组。</c>
<l>FixedCountErrors := abs(FixedCounts - ExpectedCount)</l>
<c>* 逐元素计算固定阈值检测数量与真值七之间的绝对差，得到各条件计数误差。</c>
<l>DynCountErrors := abs(DynCounts - ExpectedCount)</l>
<c>* 逐元素计算动态阈值检测数量与真值之间的绝对差。</c>
<l>FixedCountAccuracy := FixedCorrectCount * 100.0 / ConditionCount</l>
<c>* 计算固定阈值的计数正确条件比例并转换为百分比。</c>
<l>DynCountAccuracy := DynCorrectCount * 100.0 / ConditionCount</l>
<c>* 计算动态阈值的计数正确条件比例并转换为百分比。</c>
<l>FixedAverageTimeMs := mean(FixedTimesMs)</l>
<c>* 计算六组条件下固定阈值完整流程的平均耗时。</c>
<l>DynAverageTimeMs := mean(DynTimesMs)</l>
<c>* 计算六组条件下动态阈值完整流程的平均耗时。</c>
<l>dev_display (Image)</l>
<c>* 重新显示标准原图，作为最终压力测试汇总页面的背景。</c>
<l>SummaryText := ['压力测试汇总：参数全程冻结', '条件：' + ConditionNames, '', '固定阈值计数：' + FixedCounts, '固定阈值计数误差：' + FixedCountErrors, '固定阈值正确：' + FixedCorrectCount + '/' + ConditionCount + ' = ' + FixedCountAccuracy$'.1f' + '%', '固定阈值平均耗时：' + FixedAverageTimeMs$'.3f' + ' ms', '', '动态阈值计数：' + DynCounts, '动态阈值计数误差：' + DynCountErrors, '动态阈值正确：' + DynCorrectCount + '/' + ConditionCount + ' = ' + DynCountAccuracy$'.1f' + '%', '动态阈值平均耗时：' + DynAverageTimeMs$'.3f' + ' ms', '', '注意：数量正确不等于每个目标都匹配正确']</l>
<c>* 组织两种方法的数量、误差、计数正确率和平均耗时，形成最终汇总文本。</c>
<l>disp_text (WindowHandle, SummaryText, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 在窗口中显示完整测试汇总，供学习者填写记录并分析失败条件。</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
