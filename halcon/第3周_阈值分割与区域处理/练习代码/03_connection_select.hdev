<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第三周第3天：连通域与多特征区域筛选（每行代码的下一行是功能讲解）</c>
<l>dev_update_off ()</l>
<c>* 关闭 HDevelop 的自动刷新，避免每执行一行都重绘图形窗口，从而提高运行速度。</c>
<l>dev_close_window ()</l>
<c>* 关闭此前由 HDevelop 打开的图形窗口，为本次练习建立干净的显示环境。</c>
<l>read_image (Image, 'rings_and_nuts')</l>
<c>* 读取 HALCON 自带的齿形零件和螺母图像，并将图像对象保存到 Image。</c>
<l>get_image_size (Image, Width, Height)</l>
<c>* 读取原图宽度和高度，后面使用它们设置图形窗口的显示坐标范围。</c>
<l>ThresholdMax := 130</l>
<c>* 设置暗目标固定阈值的灰度上限，选择灰度小于或等于 130 的像素。</c>
<l>threshold (Image, RegionThreshold, 0, ThresholdMax)</l>
<c>* 将黑色零件和其他暗像素分割成一个联合区域对象 RegionThreshold。</c>
<l>count_obj (RegionThreshold, BeforeConnectionCount)</l>
<c>* 统计 connection 前的图标对象数量；即使区域内部彼此分离，此时通常仍只有一个 Region 对象。</c>
<l>connection (RegionThreshold, ConnectedRegions)</l>
<c>* 按像素连通关系把联合区域拆成多个独立区域对象，每个对象成为一个候选目标。</c>
<l>count_obj (ConnectedRegions, ConnectedCount)</l>
<c>* 统计拆分后的候选连通域数量；本例为 8，其中包含 7 个零件和 1 个顶部边界干扰。</c>
<l>area_center (ConnectedRegions, AllAreas, AllRows, AllColumns)</l>
<c>* 分别计算每个候选区域的面积和重心，因此三个输出变量都是与区域一一对应的元组。</c>
<l>region_features (ConnectedRegions, 'width', AllWidths)</l>
<c>* 计算每个候选区域轴对齐外接矩形的宽度，用来识别横向过宽的干扰。</c>
<l>region_features (ConnectedRegions, 'height', AllHeights)</l>
<c>* 计算每个候选区域轴对齐外接矩形的高度，用来识别过矮的细线等干扰。</c>
<l>region_features (ConnectedRegions, 'circularity', AllCircularities)</l>
<c>* 计算每个候选区域的圆度；数值越接近 1，区域整体越接近圆形。</c>
<l>region_features (ConnectedRegions, 'rectangularity', AllRectangularities)</l>
<c>* 计算每个候选区域的矩形度；该值描述区域对其轴对齐外接矩形的填充程度。</c>
<l>AreaMin := 1000</l>
<c>* 设置面积筛选下限，面积小于 1000 像素的微小区域将被排除。</c>
<l>AreaMax := 7000</l>
<c>* 设置面积筛选上限，面积大于 7000 像素的异常大区域将被排除。</c>
<l>select_shape (ConnectedRegions, AreaSelected, 'area', 'and', AreaMin, AreaMax)</l>
<c>* 按面积范围筛选候选区域；本例顶部细线面积约为 1534，所以它仍会被保留。</c>
<l>count_obj (AreaSelected, AreaCount)</l>
<c>* 统计通过面积条件的候选数量，用它验证当前面积条件实际排除了多少区域。</c>
<l>WidthMin := 50</l>
<c>* 设置目标外接矩形的最小宽度，排除宽度明显小于真实零件的区域。</c>
<l>WidthMax := 130</l>
<c>* 设置目标外接矩形的最大宽度，顶部横贯图像的细线因宽度约为 640 而不满足条件。</c>
<l>HeightMin := 50</l>
<c>* 设置目标外接矩形的最小高度，顶部细线因高度约为 3 而不满足条件。</c>
<l>HeightMax := 130</l>
<c>* 设置目标外接矩形的最大高度，排除高度明显超过真实零件尺寸的干扰。</c>
<l>select_shape (AreaSelected, SizeSelected, ['width','height'], 'and', [WidthMin,HeightMin], [WidthMax,HeightMax])</l>
<c>* 同时要求宽度和高度落入各自范围；'and' 表示两个特征条件必须全部满足。</c>
<l>count_obj (SizeSelected, SizeCount)</l>
<c>* 统计宽高筛选后保留的区域数；本例应排除顶部细线并保留 7 个真实零件。</c>
<l>area_center (SizeSelected, PartAreas, PartRows, PartColumns)</l>
<c>* 计算七个有效零件各自的面积和中心，供观察、记录以及后续定位使用。</c>
<l>region_features (SizeSelected, 'circularity', PartCircularities)</l>
<c>* 单独读取有效零件的圆度，用来观察螺母与带齿零件在该特征上的差异。</c>
<l>CircularityMin := 0.55</l>
<c>* 设置圆度下限为 0.55；本例中圆度较高的四个螺母将通过该条件。</c>
<l>select_shape (SizeSelected, RoundParts, 'circularity', 'and', CircularityMin, 1.0)</l>
<c>* 从七个有效零件中保留圆度位于 0.55 到 1.0 的区域，得到圆度较高的螺母。</c>
<l>count_obj (RoundParts, RoundCount)</l>
<c>* 统计圆度筛选后得到的螺母数量，本例默认参数下应为 4。</c>
<l>union1 (ConnectedRegions, ConnectedUnion)</l>
<c>* 将全部候选区域对象合并为一个联合区域，以便使用 difference 计算被排除的部分。</c>
<l>union1 (SizeSelected, ValidUnion)</l>
<c>* 将七个有效零件合并成一个联合区域，作为全部候选区域中的保留部分。</c>
<l>difference (ConnectedUnion, ValidUnion, RejectedUnion)</l>
<c>* 用全部候选区域减去有效零件，得到被宽高条件排除的顶部细长干扰。</c>
<l>union1 (RoundParts, RoundUnion)</l>
<c>* 将四个圆度较高的螺母合并成一个联合区域，为计算剩余零件做准备。</c>
<l>difference (ValidUnion, RoundUnion, GearUnion)</l>
<c>* 用全部有效零件减去螺母区域，得到剩余的三个带齿零件区域。</c>
<l>connection (GearUnion, GearParts)</l>
<c>* 把三个带齿零件从联合区域重新拆成独立区域对象，使其可以被正确计数。</c>
<l>count_obj (GearParts, GearCount)</l>
<c>* 统计剩余带齿零件的数量，本例默认圆度条件下应为 3。</c>
<l>dev_open_window (0, 0, Width, Height, 'black', WindowHandle)</l>
<c>* 打开与原图尺寸相同的黑色图形窗口，并把窗口句柄保存到 WindowHandle。</c>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<c>* 将窗口的显示坐标映射到整幅图像范围，确保图像按照原坐标正确显示。</c>
<l>dev_display (Image)</l>
<c>* 显示原图，让学习者先观察七个零件以及顶部的一条暗色边界干扰。</c>
<l>disp_text (WindowHandle, ['原图：rings_and_nuts', '目标：保留 7 个零件，排除顶部细线', '然后用圆度区分螺母和带齿零件'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 在窗口左上角显示本次练习的检测目标和分类任务。</c>
<l>stop ()</l>
<c>* 暂停程序供学习者观察原图，在 HDevelop 中按 F5 或点击运行后继续。</c>
<l>dev_display (Image)</l>
<c>* 重新显示原图，清除上一步的文字和显示内容，为展示阈值区域做准备。</c>
<l>dev_set_draw ('fill')</l>
<c>* 将区域显示模式设为填充，使阈值选中的全部像素清晰覆盖在原图上。</c>
<l>dev_set_color ('yellow')</l>
<c>* 将区域显示颜色设置为黄色，用来表示尚未拆分和筛选的阈值结果。</c>
<l>dev_display (RegionThreshold)</l>
<c>* 把固定阈值获得的联合区域以黄色叠加显示在原图上。</c>
<l>disp_text (WindowHandle, ['阈值只决定哪些像素入选', 'connection 前对象数：' + BeforeConnectionCount, '区域虽然分散，但仍装在一个 Region 对象中'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 显示 connection 前的对象数，强调分散像素区域不等于多个图标对象。</c>
<l>stop ()</l>
<c>* 暂停程序，让学习者理解阈值分割结果的对象组织方式，按 F5 后继续。</c>
<l>dev_display (Image)</l>
<c>* 再次显示原图，为展示 connection 拆分后的独立候选区域做准备。</c>
<l>dev_set_colored (12)</l>
<c>* 启用多颜色循环显示，使不同连通域尽可能使用不同颜色，便于观察它们已经彼此独立。</c>
<l>dev_display (ConnectedRegions)</l>
<c>* 显示 connection 拆出的全部候选区域，其中包括七个零件和顶部细线。</c>
<l>disp_text (WindowHandle, ['connection 后候选数：' + ConnectedCount, '各候选面积：' + AllAreas, '各候选宽度：' + AllWidths, '各候选高度：' + AllHeights], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 显示候选数量和各区域的面积、宽度、高度元组，寻找能区分干扰的特征。</c>
<l>stop ()</l>
<c>* 暂停程序，重点比较顶部细线与七个零件的宽高差异，按 F5 后继续。</c>
<l>dev_display (Image)</l>
<c>* 重新显示原图，为同时展示保留区域和排除区域建立干净背景。</c>
<l>dev_set_color ('red')</l>
<c>* 将显示颜色设为红色，约定红色代表被筛选条件排除的干扰区域。</c>
<l>dev_display (RejectedUnion)</l>
<c>* 以红色显示被宽高条件排除的顶部细线干扰。</c>
<l>dev_set_color ('green')</l>
<c>* 将显示颜色改为绿色，约定绿色代表通过宽高筛选的有效零件。</c>
<l>dev_display (SizeSelected)</l>
<c>* 以绿色显示宽高均符合范围的七个真实零件。</c>
<l>disp_text (WindowHandle, ['红色：被排除的顶部细线', '绿色：宽高筛选后保留的零件', '面积筛选后：' + AreaCount, '宽高筛选后：' + SizeCount], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 显示筛选前后数量，说明本例真正发挥作用的是宽高条件，而不是当前面积条件。</c>
<l>stop ()</l>
<c>* 暂停程序，让学习者检查筛选是否正确，并思考每个条件解决了哪类干扰。</c>
<l>dev_display (Image)</l>
<c>* 再次显示原图，为最终展示螺母与带齿零件的分类结果做准备。</c>
<l>dev_set_color ('cyan')</l>
<c>* 将显示颜色设为青色，用它标识圆度高于下限的螺母区域。</c>
<l>dev_display (RoundParts)</l>
<c>* 以青色显示通过圆度条件的四个螺母。</c>
<l>dev_set_color ('orange')</l>
<c>* 将显示颜色设为橙色，用它标识没有通过圆度条件的带齿零件。</c>
<l>dev_display (GearParts)</l>
<c>* 以橙色显示剩余的三个带齿零件。</c>
<l>disp_text (WindowHandle, ['青色：圆度较高的螺母，数量 ' + RoundCount, '橙色：带齿零件，数量 ' + GearCount, '圆度下限：' + CircularityMin, '七个零件的圆度：' + PartCircularities], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<c>* 显示分类数量、圆度下限和每个零件的圆度，便于分析条件过松或过紧造成的错误。</c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
