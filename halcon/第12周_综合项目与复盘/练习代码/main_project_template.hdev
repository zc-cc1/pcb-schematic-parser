<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main"><interface/><body>
<c>* 第12周综合项目：定位 -> 对齐 -> 两项检测 -> 状态 -> 统计</c>
<c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l>
<c>* [逐行] 设置置信度或匹配分数变量 MinScore 的数值初值或阈值。</c>
<l>MinScore := 0.50</l><c>* [逐行] 设置面积特征变量 MinPartArea 的数值初值或阈值。</c>
<l>MinPartArea := 100000</l><c>* [逐行] 设置面积特征变量 MaxDefectArea 的数值初值或阈值。</c>
<l>MaxDefectArea := 180</l>
<c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Background,'byte',640,480)</l><c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (Part,120,100,360,540)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>paint_region (Part,Background,ReferenceImage,160,'fill')</l>
<c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (TemplateROI,105,85,375,555)</l><c>* [逐行] 把图像定义域限制到ROI；图像矩阵尺寸不变，但后续仅处理域内像素。</c>
<l>reduce_domain (ReferenceImage,TemplateROI,TemplateImage)</l><c>* [逐行] 根据模板图像创建形状匹配模型并返回模型句柄。</c>
<l>create_shape_model (TemplateImage,'auto',rad(-12),rad(24),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<c>* [逐行] 在搜索图像中查找形状模型，返回位置、角度和匹配分数。</c>
<l>find_shape_model (ReferenceImage,ModelID,rad(-12),rad(24),MinScore,1,0.5,'least_squares',0,0.8,RefRow,RefColumn,RefAngle,RefScore)</l>
<c>* [逐行] 设置混淆矩阵计数变量 TP 的数值初值或阈值。</c>
<l>TP := 0</l><c>* [逐行] 设置混淆矩阵计数变量 TN 的数值初值或阈值。</c>
<l>TN := 0</l><c>* [逐行] 设置混淆矩阵计数变量 FP 的数值初值或阈值。</c>
<l>FP := 0</l><c>* [逐行] 设置混淆矩阵计数变量 FN 的数值初值或阈值。</c>
<l>FN := 0</l><c>* [逐行] 设置计数或索引变量 LocateFailures 的数值初值或阈值。</c>
<l>LocateFailures := 0</l><c>* [逐行] 把运行耗时变量 TimesMS 初始化为空元组，供后续收集结果。</c>
<l>TimesMS := []</l><c>* [逐行] 把检测状态变量 StatusLog 初始化为空元组，供后续收集结果。</c>
<l>StatusLog := []</l>
<c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 0 to 29 by 1</l>
<c>* [逐行] 计算判断条件，并把真假结果保存到 GroundTruthNG。</c>
<l>    GroundTruthNG := I%4 == 0</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (GroundTruthNG)</l>
<c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>        gen_circle (ArtificialDefect,210+(I%5)*16,260+(I%6)*28,10+(I%4)*4)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>        paint_region (ArtificialDefect,ReferenceImage,SourceImage,25,'fill')</l>
<c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 复制指定图形对象，得到独立的输出对象引用。</c>
<l>        copy_obj (ReferenceImage,SourceImage,1,1)</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l>
<c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>    hom_mat2d_identity (KnownMove)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>    hom_mat2d_rotate (KnownMove,rad((I%7-3)*2),240,320,KnownMove)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>    hom_mat2d_translate (KnownMove,(I%5-2)*4,(I%6-3)*3,KnownMove)</l>
<c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>    affine_trans_image (SourceImage,TestImage,KnownMove,'constant','false')</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T0)</l>
<c>* [逐行] 在搜索图像中查找形状模型，返回位置、角度和匹配分数。</c>
<l>    find_shape_model (TestImage,ModelID,rad(-12),rad(24),MinScore,1,0.5,'least_squares',0,0.8,Row,Column,Angle,Score)</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (|Score| == 0)</l>
<c>* [逐行] 把计数或索引变量 LocateFailures 加1，记录一次新的事件。</c>
<l>        LocateFailures := LocateFailures+1</l><c>* [逐行] 设置布尔判定结果变量 PredictedNG 的初始真假状态。</c>
<l>        PredictedNG := true</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>        Status := 'LOCATE_FAILED'</l><c>* [逐行] 创建空的图形对象，作为无结果状态或对象收集器的初值。</c>
<l>        gen_empty_obj (Defects)</l><c>* [逐行] 设置面积特征变量 PartArea 的数值初值或阈值。</c>
<l>        PartArea := 0</l><c>* [逐行] 设置面积特征变量 TotalDefectArea 的数值初值或阈值。</c>
<l>        TotalDefectArea := -1</l>
<c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l>
<c>* [逐行] 根据参考位姿和当前位姿建立二维刚性变换矩阵。</c>
<l>        vector_angle_to_rigid (Row[0],Column[0],Angle[0],RefRow[0],RefColumn[0],RefAngle[0],AlignMat)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>        affine_trans_image (TestImage,AlignedImage,AlignMat,'constant','false')</l>
<c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>        threshold (AlignedImage,PartRegion,100,255)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>        area_center (PartRegion,PartArea,PartRow,PartColumn)</l>
<c>* [逐行] 计算两幅图像对应像素的绝对灰度差，用于突出变化或缺陷。</c>
<l>        abs_diff_image (ReferenceImage,AlignedImage,DiffImage,1)</l><c>* [逐行] 把图像定义域限制到ROI；图像矩阵尺寸不变，但后续仅处理域内像素。</c>
<l>        reduce_domain (DiffImage,Part,DiffInsidePart)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>        threshold (DiffInsidePart,Candidates,70,255)</l>
<c>* [逐行] 使用圆形结构元素做开运算，以去除小区域和细小连接。</c>
<l>        opening_circle (Candidates,CandidatesOpened,1.5)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>        connection (CandidatesOpened,Connected)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>        select_shape (Connected,Defects,'area','and',40,999999)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>        area_center (Defects,DefectAreas,DefectRows,DefectColumns)</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>        if (|DefectAreas| &gt; 0)</l><c>* [逐行] 根据当前数据计算面积特征，并把结果保存到 TotalDefectArea。</c>
<l>            TotalDefectArea := sum(DefectAreas)</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>        else</l><c>* [逐行] 设置面积特征变量 TotalDefectArea 的数值初值或阈值。</c>
<l>            TotalDefectArea := 0</l><c>* [逐行] 结束当前条件分支。</c>
<l>        endif</l>
<c>* [逐行] 计算判断条件，并把真假结果保存到 AreaOK。</c>
<l>        AreaOK := PartArea &gt;= MinPartArea</l><c>* [逐行] 计算判断条件，并把真假结果保存到 SurfaceOK。</c>
<l>        SurfaceOK := TotalDefectArea &lt;= MaxDefectArea</l><c>* [逐行] 计算判断条件，并把真假结果保存到 PredictedNG。</c>
<l>        PredictedNG := not (AreaOK and SurfaceOK)</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>        if (PredictedNG)</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>            Status := 'NG_QUALITY'</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>        else</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>            Status := 'OK'</l><c>* [逐行] 结束当前条件分支。</c>
<l>        endif</l>
<c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l>
<c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T1)</l><c>* [逐行] 把本次结果追加到运行耗时变量 TimesMS 中。</c>
<l>    TimesMS := [TimesMS,(T1-T0)*1000]</l><c>* [逐行] 把本次结果追加到检测状态变量 StatusLog 中。</c>
<l>    StatusLog := [StatusLog,Status]</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (GroundTruthNG and PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 TP 加1，记录一次新的事件。</c>
<l>        TP := TP+1</l><c>* [逐行] 前一条件不成立时继续判断这个补充条件。</c>
<l>    elseif (not GroundTruthNG and not PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 TN 加1，记录一次新的事件。</c>
<l>        TN := TN+1</l><c>* [逐行] 前一条件不成立时继续判断这个补充条件。</c>
<l>    elseif (not GroundTruthNG and PredictedNG)</l><c>* [逐行] 把混淆矩阵计数变量 FP 加1，记录一次新的事件。</c>
<l>        FP := FP+1</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l><c>* [逐行] 把混淆矩阵计数变量 FN 加1，记录一次新的事件。</c>
<l>        FN := FN+1</l><c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l>
<c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l>
<c>* [逐行] 对数值元组升序排序，供中位数或分位耗时计算使用。</c>
<l>tuple_sort (TimesMS,SortedTimes)</l><c>* [逐行] 从元组中读取指定元素或组合数据，并保存到 P95。</c>
<l>P95 := SortedTimes[floor(0.95*(|SortedTimes|-1))]</l>
<c>* [逐行] 释放形状模板句柄，避免模型资源泄漏。</c>
<l>clear_shape_model (ModelID)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,480,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (TestImage)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Defects)</l>
<c>* [逐行] 设置文本或标识信息变量 Message 的元组数据，供后续批量处理。</c>
<l>Message := ['第12周综合项目完成','最后状态：' + Status,'PartArea / DefectArea：',PartArea,TotalDefectArea,'TP / TN / FP / FN：',TP,TN,FP,FN,'定位失败：',LocateFailures,'平均耗时 / P95耗时(ms)：',mean(TimesMS),P95]</l>
<c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,Message,'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure>
</hdevelop>
