<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第12周第3天：完整性和表面缺陷是两个独立检测项</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Background,'byte',640,480)</l><c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (Part,120,100,360,540)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>paint_region (Part,Background,ReferenceImage,160,'fill')</l><c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>gen_circle (Defect,220,320,14)</l><c>* [逐行] 用指定灰度值把区域绘制到图像中，生成合成目标或缺陷。</c>
<l>paint_region (Defect,ReferenceImage,TestImage,30,'fill')</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (TestImage,PartRegion,100,255)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (PartRegion,PartArea,PartRow,PartColumn)</l><c>* [逐行] 计算两幅图像对应像素的绝对灰度差，用于突出变化或缺陷。</c>
<l>abs_diff_image (ReferenceImage,TestImage,DiffImage,1)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (DiffImage,DefectRegion,50,255)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (DefectRegion,DefectArea,DefectRow,DefectColumn)</l><c>* [逐行] 计算判断条件，并把真假结果保存到 AreaOK。</c>
<l>AreaOK := PartArea &gt;= 100000</l><c>* [逐行] 计算判断条件，并把真假结果保存到 SurfaceOK。</c>
<l>SurfaceOK := DefectArea &lt;= 180</l><c>* [逐行] 计算判断条件，并把真假结果保存到 OverallOK。</c>
<l>OverallOK := AreaOK and SurfaceOK</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,480,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (TestImage)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (DefectRegion)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['零件面积：' + PartArea$'.0f' + '，合格=' + AreaOK$'','缺陷面积：' + DefectArea$'.0f' + '，合格=' + SurfaceOK$'','总结果OK=' + OverallOK$''], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
