<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第12周第2天：定位管线</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (ReferenceImage,'rings_and_nuts')</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (ReferenceImage,Width,Height)</l><c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>gen_rectangle1 (TemplateROI,60,60,200,200)</l><c>* [逐行] 把图像定义域限制到ROI；图像矩阵尺寸不变，但后续仅处理域内像素。</c>
<l>reduce_domain (ReferenceImage,TemplateROI,TemplateImage)</l><c>* [逐行] 根据模板图像创建形状匹配模型并返回模型句柄。</c>
<l>create_shape_model (TemplateImage,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',ModelID)</l><c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>hom_mat2d_identity (Move)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>hom_mat2d_rotate (Move,rad(16),Height/2,Width/2,Move)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>hom_mat2d_translate (Move,15,-20,Move)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>affine_trans_image (ReferenceImage,TestImage,Move,'constant','false')</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>count_seconds (T0)</l><c>* [逐行] 在搜索图像中查找形状模型，返回位置、角度和匹配分数。</c>
<l>find_shape_model (TestImage,ModelID,rad(-45),rad(90),0.45,1,0.5,'least_squares',0,0.8,Row,Column,Angle,Score)</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>count_seconds (T1)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (TestImage)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (|Score| &gt; 0)</l><c>* [逐行] 在指定坐标生成十字XLD，用于标记位置或特征点。</c>
<l>    gen_cross_contour_xld (Cross,Row,Column,20,Angle)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>    dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>    dev_display (Cross)</l><c>* [逐行] 设置文本或标识信息变量 Message 的元组数据，供后续批量处理。</c>
<l>    Message := ['定位成功','Row/Column=' + Row[0]$'.1f' + '/' + Column[0]$'.1f','Angle=' + deg(Angle[0])$'.2f' + ' 度','Score=' + Score[0]$'.3f','Time=' + ((T1-T0)*1000)$'.2f' + ' ms']</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>else</l><c>* [逐行] 设置文本或标识信息变量 Message 的字符串值。</c>
<l>    Message := 'LOCATE_FAILED'</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,Message,'window',12,12,'white',['box_color'],['black'])</l><c>* [逐行] 释放形状模板句柄，避免模型资源泄漏。</c>
<l>clear_shape_model (ModelID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
