<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第12周第4天：结果日志至少包含样本、状态、特征和耗时</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 设置文本或标识信息变量 LogFile 的字符串值。</c>
<l>LogFile := 'week12_result.csv'</l><c>* [逐行] 设置控制变量变量 SampleIDs 的元组数据，供后续批量处理。</c>
<l>SampleIDs := ['P0001','P0002','P0003','P0004']</l><c>* [逐行] 设置检测状态变量 Status 的元组数据，供后续批量处理。</c>
<l>Status := ['OK','NG_DEFECT','LOCATE_FAILED','INPUT_ERROR']</l><c>* [逐行] 设置置信度或匹配分数变量 Scores 的元组数据，供后续批量处理。</c>
<l>Scores := [0.92,0.88,0,0]</l><c>* [逐行] 设置面积特征变量 DefectAreas 的元组数据，供后续批量处理。</c>
<l>DefectAreas := [0,486,-1,-1]</l><c>* [逐行] 设置运行耗时变量 TimesMS 的元组数据，供后续批量处理。</c>
<l>TimesMS := [12.3,13.1,35.0,1.2]</l><c>* [逐行] 按指定模式打开文本文件，并返回文件句柄。</c>
<l>open_file (LogFile,'output',FileHandle)</l><c>* [逐行] 把指定字符串写入已经打开的文本文件。</c>
<l>fwrite_string (FileHandle,'sample_id,status,score,defect_area,time_ms')</l><c>* [逐行] 向文本文件写入换行符，开始下一条日志记录。</c>
<l>fnew_line (FileHandle)</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 0 to |SampleIDs|-1 by 1</l><c>* [逐行] 从元组中读取指定元素或组合数据，并保存到 Line。</c>
<l>    Line := SampleIDs[I] + ',' + Status[I] + ',' + Scores[I]$'.3f' + ',' + DefectAreas[I]$'.0f' + ',' + TimesMS[I]$'.2f'</l><c>* [逐行] 把指定字符串写入已经打开的文本文件。</c>
<l>    fwrite_string (FileHandle,Line)</l><c>* [逐行] 向文本文件写入换行符，开始下一条日志记录。</c>
<l>    fnew_line (FileHandle)</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 关闭已经打开的文件句柄，确保数据写入并释放文件资源。</c>
<l>close_file (FileHandle)</l><c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (Image,'byte',760,360)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,760,360,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['日志已写入：' + LogFile,'字段：sample_id,status,score,defect_area,time_ms','失败样本也必须留下一行记录'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
