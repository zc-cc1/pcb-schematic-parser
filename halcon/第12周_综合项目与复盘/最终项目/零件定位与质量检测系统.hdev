<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>OutputDir := 'halcon_final_output'</l>
<l>ExpectedWidth := 640</l>
<l>ExpectedHeight := 480</l>
<l>MinMeanGray := 20.0</l>
<l>MaxMeanGray := 210.0</l>
<l>MinGrayDeviation := 12.0</l>
<l>SearchMinScore := 0.35</l>
<l>AcceptMinScore := 0.62</l>
<l>MinPartWidth := 435.0</l>
<l>MaxPartWidth := 447.0</l>
<l>MinPartHeight := 235.0</l>
<l>MaxPartHeight := 247.0</l>
<l>MaxPresenceMean := 85.0</l>
<l>MaxDefectArea := 120.0</l>
<l>NumSamples := 60</l>
<l>file_exists (OutputDir,OutputExists)</l>
<l>if (not OutputExists)</l>
<l>    make_dir (OutputDir)</l>
<l>endif</l>
<l>build_reference (ReferenceImage,PartRegion,SurfaceROI,PresenceROI,TemplateROI,ModelID,RefRow,RefColumn,RefAngle)</l>
<l>LogFile := OutputDir + '/results.csv'</l>
<l>open_file (LogFile,'output',LogHandle)</l>
<l>fwrite_string (LogHandle,'sample_id,ground_truth,status,score,width,height,presence_mean,defect_area,image_mean,image_deviation,time_ms')</l>
<l>fnew_line (LogHandle)</l>
<l>TP := 0</l>
<l>TN := 0</l>
<l>FP := 0</l>
<l>FN := 0</l>
<l>LocateAttempts := 0</l>
<l>LocateSuccesses := 0</l>
<l>LocateFailures := 0</l>
<l>TimesMS := []</l>
<l>StatusLog := []</l>
<l>GroundTruthLog := []</l>
<l>for I := 0 to NumSamples-1 by 1</l>
<l>    count_seconds (T0)</l>
<l>    SampleID := 'S' + (I+1)$'03d'</l>
<l>    try</l>
<l>        generate_sample (ReferenceImage,SampleImage,I,GroundTruthNG,GroundTruthClass)</l>
<l>        check_image_quality (SampleImage,ExpectedWidth,ExpectedHeight,MinMeanGray,MaxMeanGray,MinGrayDeviation,QualityStatus,ImageMean,ImageDeviation)</l>
<l>        if (QualityStatus == 'OK')</l>
<l>            if (GroundTruthClass != 'NO_PART')</l>
<l>                LocateAttempts := LocateAttempts+1</l>
<l>            endif</l>
<l>            inspect_part (SampleImage,ReferenceImage,SurfaceROI,PresenceROI,AlignedImage,Defects,ModelID,RefRow,RefColumn,RefAngle,SearchMinScore,AcceptMinScore,MinPartWidth,MaxPartWidth,MinPartHeight,MaxPartHeight,MaxPresenceMean,MaxDefectArea,Status,Score,PartWidth,PartHeight,PresenceMean,DefectArea)</l>
<l>            if (GroundTruthClass != 'NO_PART')</l>
<l>                if (Status == 'LOCATE_FAILED')</l>
<l>                    LocateFailures := LocateFailures+1</l>
<l>                else</l>
<l>                    LocateSuccesses := LocateSuccesses+1</l>
<l>                endif</l>
<l>            endif</l>
<l>        else</l>
<l>            copy_obj (SampleImage,AlignedImage,1,1)</l>
<l>            gen_empty_obj (Defects)</l>
<l>            Status := QualityStatus</l>
<l>            Score := 0.0</l>
<l>            PartWidth := 0.0</l>
<l>            PartHeight := 0.0</l>
<l>            PresenceMean := -1.0</l>
<l>            DefectArea := -1.0</l>
<l>        endif</l>
<l>    catch (Exception)</l>
<l>        gen_image_const (SampleImage,'byte',ExpectedWidth,ExpectedHeight)</l>
<l>        copy_obj (SampleImage,AlignedImage,1,1)</l>
<l>        gen_empty_obj (Defects)</l>
<l>        GroundTruthNG := true</l>
<l>        GroundTruthClass := 'RUNTIME_ERROR'</l>
<l>        Status := 'RUNTIME_ERROR'</l>
<l>        Score := 0.0</l>
<l>        PartWidth := 0.0</l>
<l>        PartHeight := 0.0</l>
<l>        PresenceMean := -1.0</l>
<l>        DefectArea := -1.0</l>
<l>        ImageMean := 0.0</l>
<l>        ImageDeviation := 0.0</l>
<l>    endtry</l>
<l>    count_seconds (T1)</l>
<l>    TimeMS := (T1-T0)*1000.0</l>
<l>    TimesMS := [TimesMS,TimeMS]</l>
<l>    PredictedNG := Status != 'OK'</l>
<l>    if (GroundTruthNG and PredictedNG)</l>
<l>        TP := TP+1</l>
<l>    elseif (not GroundTruthNG and not PredictedNG)</l>
<l>        TN := TN+1</l>
<l>    elseif (not GroundTruthNG and PredictedNG)</l>
<l>        FP := FP+1</l>
<l>    else</l>
<l>        FN := FN+1</l>
<l>    endif</l>
<l>    StatusLog := [StatusLog,Status]</l>
<l>    GroundTruthLog := [GroundTruthLog,GroundTruthClass]</l>
<l>    LogLine := SampleID + ',' + GroundTruthClass + ',' + Status + ',' + Score$'.4f' + ',' + PartWidth$'.2f' + ',' + PartHeight$'.2f' + ',' + PresenceMean$'.2f' + ',' + DefectArea$'.2f' + ',' + ImageMean$'.2f' + ',' + ImageDeviation$'.2f' + ',' + TimeMS$'.3f'</l>
<l>    fwrite_string (LogHandle,LogLine)</l>
<l>    fnew_line (LogHandle)</l>
<l>    if (Status != 'OK')</l>
<l>        write_image (SampleImage,'png',0,OutputDir + '/failed_' + SampleID + '.png')</l>
<l>    endif</l>
<l>    if (I == 6)</l>
<l>        copy_obj (SampleImage,VisualizationImage,1,1)</l>
<l>        copy_obj (AlignedImage,VisualizationAligned,1,1)</l>
<l>        copy_obj (Defects,VisualizationDefects,1,-1)</l>
<l>        VisualizationStatus := Status</l>
<l>        VisualizationScore := Score</l>
<l>        VisualizationDefectArea := DefectArea</l>
<l>    endif</l>
<l>endfor</l>
<l>close_file (LogHandle)</l>
<l>Accuracy := (TP+TN)*1.0/NumSamples</l>
<l>Precision := TP*1.0/max2(1,TP+FP)</l>
<l>Recall := TP*1.0/max2(1,TP+FN)</l>
<l>FalsePositiveRate := FP*1.0/max2(1,FP+TN)</l>
<l>FalseNegativeRate := FN*1.0/max2(1,FN+TP)</l>
<l>LocalizationRate := LocateSuccesses*1.0/max2(1,LocateAttempts)</l>
<l>AverageTimeMS := mean(TimesMS)</l>
<l>MaxTimeMS := max(TimesMS)</l>
<l>tuple_sort (TimesMS,SortedTimes)</l>
<l>P95Index := floor(0.95*(|SortedTimes|-1))</l>
<l>P95TimeMS := SortedTimes[P95Index]</l>
<l>MetricsFile := OutputDir + '/metrics.csv'</l>
<l>open_file (MetricsFile,'output',MetricsHandle)</l>
<l>fwrite_string (MetricsHandle,'samples,tp,tn,fp,fn,accuracy,precision,recall,false_positive_rate,false_negative_rate,localization_rate,average_time_ms,p95_time_ms,max_time_ms')</l>
<l>fnew_line (MetricsHandle)</l>
<l>MetricsLine := NumSamples + ',' + TP + ',' + TN + ',' + FP + ',' + FN + ',' + Accuracy$'.6f' + ',' + Precision$'.6f' + ',' + Recall$'.6f' + ',' + FalsePositiveRate$'.6f' + ',' + FalseNegativeRate$'.6f' + ',' + LocalizationRate$'.6f' + ',' + AverageTimeMS$'.3f' + ',' + P95TimeMS$'.3f' + ',' + MaxTimeMS$'.3f'</l>
<l>fwrite_string (MetricsHandle,MetricsLine)</l>
<l>fnew_line (MetricsHandle)</l>
<l>close_file (MetricsHandle)</l>
<l>CheckPassed := Accuracy &gt;= 0.95 and FalsePositiveRate &lt;= 0.05 and FalseNegativeRate &lt;= 0.05 and LocalizationRate &gt;= 0.95</l>
<l>clear_shape_model (ModelID)</l>
<l>dev_open_window (0,0,ExpectedWidth,ExpectedHeight,'black',WindowHandle)</l>
<l>dev_display (VisualizationAligned)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('red')</l>
<l>dev_display (VisualizationDefects)</l>
<l>ResultMessage := ['HALCON FINAL PROJECT','Sample status: ' + VisualizationStatus,'Match score: ' + VisualizationScore$'.3f','Defect area: ' + VisualizationDefectArea$'.1f','TP/TN/FP/FN: ' + TP + '/' + TN + '/' + FP + '/' + FN,'Accuracy: ' + Accuracy$'.3f','FPR/FNR: ' + FalsePositiveRate$'.3f' + '/' + FalseNegativeRate$'.3f','Localization: ' + LocalizationRate$'.3f','Average/P95/Max ms: ' + AverageTimeMS$'.2f' + '/' + P95TimeMS$'.2f' + '/' + MaxTimeMS$'.2f','Output: ' + OutputDir]</l>
<l>disp_text (WindowHandle,ResultMessage,'window',12,12,'white',['box_color'],['black'])</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="build_reference">
<interface>
<oo>
<par name="ReferenceImage" base_type="iconic" dimension="0"/>
<par name="PartRegion" base_type="iconic" dimension="0"/>
<par name="SurfaceROI" base_type="iconic" dimension="0"/>
<par name="PresenceROI" base_type="iconic" dimension="0"/>
<par name="TemplateROI" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="ModelID" base_type="ctrl" dimension="0"/>
<par name="RefRow" base_type="ctrl" dimension="0"/>
<par name="RefColumn" base_type="ctrl" dimension="0"/>
<par name="RefAngle" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>gen_image_const (EmptyImage,'byte',640,480)</l>
<l>get_domain (EmptyImage,FullDomain)</l>
<l>paint_region (FullDomain,EmptyImage,BackgroundImage,30,'fill')</l>
<l>gen_rectangle1 (OuterRegion,120,100,360,540)</l>
<l>gen_circle (HoleLeft,180,180,18)</l>
<l>gen_circle (HoleRight,295,455,25)</l>
<l>difference (OuterRegion,HoleLeft,PartWithoutLeftHole)</l>
<l>difference (PartWithoutLeftHole,HoleRight,PartRegion)</l>
<l>paint_region (PartRegion,BackgroundImage,ReferenceImage,170,'fill')</l>
<l>erosion_circle (PartRegion,SurfaceROI,14.0)</l>
<l>gen_circle (PresenceROI,180,180,12)</l>
<l>gen_rectangle1 (TemplateROI,105,85,375,555)</l>
<l>reduce_domain (ReferenceImage,TemplateROI,TemplateImage)</l>
<l>create_shape_model (TemplateImage,'auto',rad(-15),rad(30),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<l>find_shape_model (ReferenceImage,ModelID,rad(-15),rad(30),0.6,1,0.5,'least_squares',0,0.8,Rows,Columns,Angles,Scores)</l>
<l>RefRow := Rows[0]</l>
<l>RefColumn := Columns[0]</l>
<l>RefAngle := Angles[0]</l>
<l>return ()</l>
</body>
<docu id="build_reference">
<parameters>
<parameter id="ModelID"/>
<parameter id="PartRegion"/>
<parameter id="PresenceROI"/>
<parameter id="RefAngle"/>
<parameter id="RefColumn"/>
<parameter id="RefRow"/>
<parameter id="ReferenceImage"/>
<parameter id="SurfaceROI"/>
<parameter id="TemplateROI"/>
</parameters>
</docu>
</procedure>
<procedure name="generate_sample">
<interface>
<io>
<par name="ReferenceImage" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SampleImage" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Index" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="GroundTruthNG" base_type="ctrl" dimension="0"/>
<par name="GroundTruthClass" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Mode := Index%12</l>
<l>GroundTruthNG := false</l>
<l>GroundTruthClass := 'OK'</l>
<l>copy_obj (ReferenceImage,BaseImage,1,1)</l>
<l>if (Mode == 6)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'SURFACE_SCRATCH'</l>
<l>    ScratchRow := 230+(Index%3-1)*22</l>
<l>    ScratchColumn := 310+(Index%4-1)*35</l>
<l>    gen_rectangle2 (Scratch,ScratchRow,ScratchColumn,rad(18+(Index%3)*21),34,3.5)</l>
<l>    paint_region (Scratch,BaseImage,BaseImage,35,'fill')</l>
<l>elseif (Mode == 7)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'SURFACE_SPOT'</l>
<l>    gen_circle (Spot,235+(Index%3)*18,320+(Index%4)*24,10)</l>
<l>    paint_region (Spot,BaseImage,BaseImage,20,'fill')</l>
<l>elseif (Mode == 8)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'MISSING_FEATURE'</l>
<l>    gen_circle (MissingFeature,180,180,17)</l>
<l>    paint_region (MissingFeature,BaseImage,BaseImage,170,'fill')</l>
<l>elseif (Mode == 9)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'DIMENSION_SHORT'</l>
<l>    gen_rectangle1 (CutRegion,110,505,370,550)</l>
<l>    paint_region (CutRegion,BaseImage,BaseImage,30,'fill')</l>
<l>elseif (Mode == 10)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'INPUT_DARK'</l>
<l>    gen_image_const (DarkImage,'byte',640,480)</l>
<l>    get_domain (DarkImage,DarkDomain)</l>
<l>    paint_region (DarkDomain,DarkImage,BaseImage,5,'fill')</l>
<l>elseif (Mode == 11)</l>
<l>    GroundTruthNG := true</l>
<l>    GroundTruthClass := 'NO_PART'</l>
<l>    gen_image_const (NoPartImage,'byte',640,480)</l>
<l>    get_domain (NoPartImage,NoPartDomain)</l>
<l>    paint_region (NoPartDomain,NoPartImage,BaseImage,30,'fill')</l>
<l>    gen_rectangle1 (Distractor1,70,70,210,205)</l>
<l>    gen_circle (Distractor2,320,440,55)</l>
<l>    paint_region (Distractor1,BaseImage,BaseImage,170,'fill')</l>
<l>    paint_region (Distractor2,BaseImage,BaseImage,110,'fill')</l>
<l>endif</l>
<l>Rotation := rad(((Index*7)%21)-10)</l>
<l>RowShift := ((Index*11)%31)-15</l>
<l>ColumnShift := ((Index*13)%41)-20</l>
<l>hom_mat2d_identity (Move)</l>
<l>hom_mat2d_rotate (Move,Rotation,240,320,Move)</l>
<l>hom_mat2d_translate (Move,RowShift,ColumnShift,Move)</l>
<l>affine_trans_image (BaseImage,SampleImage,Move,'constant','false')</l>
<l>return ()</l>
</body>
<docu id="generate_sample">
<parameters>
<parameter id="GroundTruthClass"/>
<parameter id="GroundTruthNG"/>
<parameter id="Index"/>
<parameter id="ReferenceImage"/>
<parameter id="SampleImage"/>
</parameters>
</docu>
</procedure>
<procedure name="check_image_quality">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="ExpectedWidth" base_type="ctrl" dimension="0"/>
<par name="ExpectedHeight" base_type="ctrl" dimension="0"/>
<par name="MinMeanGray" base_type="ctrl" dimension="0"/>
<par name="MaxMeanGray" base_type="ctrl" dimension="0"/>
<par name="MinGrayDeviation" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Status" base_type="ctrl" dimension="0"/>
<par name="MeanGray" base_type="ctrl" dimension="0"/>
<par name="GrayDeviation" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>get_image_size (Image,Width,Height)</l>
<l>get_domain (Image,ImageDomain)</l>
<l>intensity (ImageDomain,Image,MeanGray,GrayDeviation)</l>
<l>if (Width != ExpectedWidth or Height != ExpectedHeight)</l>
<l>    Status := 'INPUT_SIZE_ERROR'</l>
<l>elseif (MeanGray &lt; MinMeanGray)</l>
<l>    Status := 'INPUT_DARK'</l>
<l>elseif (MeanGray &gt; MaxMeanGray)</l>
<l>    Status := 'INPUT_BRIGHT'</l>
<l>elseif (GrayDeviation &lt; MinGrayDeviation)</l>
<l>    Status := 'INPUT_LOW_CONTRAST'</l>
<l>else</l>
<l>    Status := 'OK'</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="check_image_quality">
<parameters>
<parameter id="ExpectedHeight"/>
<parameter id="ExpectedWidth"/>
<parameter id="GrayDeviation"/>
<parameter id="Image"/>
<parameter id="MaxMeanGray"/>
<parameter id="MeanGray"/>
<parameter id="MinGrayDeviation"/>
<parameter id="MinMeanGray"/>
<parameter id="Status"/>
</parameters>
</docu>
</procedure>
<procedure name="inspect_part">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="ReferenceImage" base_type="iconic" dimension="0"/>
<par name="SurfaceROI" base_type="iconic" dimension="0"/>
<par name="PresenceROI" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="AlignedImage" base_type="iconic" dimension="0"/>
<par name="Defects" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ModelID" base_type="ctrl" dimension="0"/>
<par name="RefRow" base_type="ctrl" dimension="0"/>
<par name="RefColumn" base_type="ctrl" dimension="0"/>
<par name="RefAngle" base_type="ctrl" dimension="0"/>
<par name="SearchMinScore" base_type="ctrl" dimension="0"/>
<par name="AcceptMinScore" base_type="ctrl" dimension="0"/>
<par name="MinPartWidth" base_type="ctrl" dimension="0"/>
<par name="MaxPartWidth" base_type="ctrl" dimension="0"/>
<par name="MinPartHeight" base_type="ctrl" dimension="0"/>
<par name="MaxPartHeight" base_type="ctrl" dimension="0"/>
<par name="MaxPresenceMean" base_type="ctrl" dimension="0"/>
<par name="MaxDefectArea" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Status" base_type="ctrl" dimension="0"/>
<par name="Score" base_type="ctrl" dimension="0"/>
<par name="PartWidth" base_type="ctrl" dimension="0"/>
<par name="PartHeight" base_type="ctrl" dimension="0"/>
<par name="PresenceMean" base_type="ctrl" dimension="0"/>
<par name="DefectArea" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>copy_obj (Image,AlignedImage,1,1)</l>
<l>gen_empty_obj (Defects)</l>
<l>Status := 'LOCATE_FAILED'</l>
<l>Score := 0.0</l>
<l>PartWidth := 0.0</l>
<l>PartHeight := 0.0</l>
<l>PresenceMean := -1.0</l>
<l>DefectArea := -1.0</l>
<l>find_shape_model (Image,ModelID,rad(-15),rad(30),SearchMinScore,2,0.4,'least_squares',0,0.8,Rows,Columns,Angles,Scores)</l>
<l>if (|Scores| == 0)</l>
<l>    Status := 'LOCATE_FAILED'</l>
<l>elseif (|Scores| &gt; 1)</l>
<l>    Score := Scores[0]</l>
<l>    Status := 'MULTI_OBJECT'</l>
<l>elseif (Scores[0] &lt; AcceptMinScore)</l>
<l>    Score := Scores[0]</l>
<l>    Status := 'LOW_SCORE'</l>
<l>else</l>
<l>    Score := Scores[0]</l>
<l>    vector_angle_to_rigid (Rows[0],Columns[0],Angles[0],RefRow,RefColumn,RefAngle,AlignTransform)</l>
<l>    affine_trans_image (Image,AlignedImage,AlignTransform,'constant','false')</l>
<l>    threshold (AlignedImage,BrightRegion,100,255)</l>
<l>    connection (BrightRegion,ConnectedParts)</l>
<l>    select_shape (ConnectedParts,PartCandidates,'area','and',50000,999999)</l>
<l>    area_center (PartCandidates,PartAreas,PartRows,PartColumns)</l>
<l>    if (|PartAreas| == 0)</l>
<l>        Status := 'SEGMENTATION_FAILED'</l>
<l>    else</l>
<l>        smallest_rectangle1 (PartCandidates,PartRow1,PartColumn1,PartRow2,PartColumn2)</l>
<l>        PartWidth := PartColumn2[0]-PartColumn1[0]+1</l>
<l>        PartHeight := PartRow2[0]-PartRow1[0]+1</l>
<l>        intensity (PresenceROI,AlignedImage,PresenceMean,PresenceDeviation)</l>
<l>        abs_diff_image (ReferenceImage,AlignedImage,DifferenceImage,1)</l>
<l>        reduce_domain (DifferenceImage,SurfaceROI,SurfaceDifference)</l>
<l>        threshold (SurfaceDifference,DefectCandidates,55,255)</l>
<l>        opening_circle (DefectCandidates,OpenedDefects,1.5)</l>
<l>        connection (OpenedDefects,ConnectedDefects)</l>
<l>        select_shape (ConnectedDefects,Defects,'area','and',40,999999)</l>
<l>        area_center (Defects,DefectAreas,DefectRows,DefectColumns)</l>
<l>        if (|DefectAreas| &gt; 0)</l>
<l>            DefectArea := sum(DefectAreas)</l>
<l>        else</l>
<l>            DefectArea := 0.0</l>
<l>        endif</l>
<l>        DimensionOK := PartWidth &gt;= MinPartWidth and PartWidth &lt;= MaxPartWidth and PartHeight &gt;= MinPartHeight and PartHeight &lt;= MaxPartHeight</l>
<l>        PresenceOK := PresenceMean &lt;= MaxPresenceMean</l>
<l>        SurfaceOK := DefectArea &lt;= MaxDefectArea</l>
<l>        Status := 'OK'</l>
<l>        if (not DimensionOK)</l>
<l>            Status := 'NG_DIMENSION'</l>
<l>        endif</l>
<l>        if (not PresenceOK)</l>
<l>            if (Status == 'OK')</l>
<l>                Status := 'NG_PRESENCE'</l>
<l>            else</l>
<l>                Status := Status + '+PRESENCE'</l>
<l>            endif</l>
<l>        endif</l>
<l>        if (not SurfaceOK)</l>
<l>            if (Status == 'OK')</l>
<l>                Status := 'NG_SURFACE'</l>
<l>            else</l>
<l>                Status := Status + '+SURFACE'</l>
<l>            endif</l>
<l>        endif</l>
<l>    endif</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="inspect_part">
<parameters>
<parameter id="AcceptMinScore"/>
<parameter id="AlignedImage"/>
<parameter id="DefectArea"/>
<parameter id="Defects"/>
<parameter id="Image"/>
<parameter id="MaxDefectArea"/>
<parameter id="MaxPartHeight"/>
<parameter id="MaxPartWidth"/>
<parameter id="MaxPresenceMean"/>
<parameter id="MinPartHeight"/>
<parameter id="MinPartWidth"/>
<parameter id="ModelID"/>
<parameter id="PartHeight"/>
<parameter id="PartWidth"/>
<parameter id="PresenceMean"/>
<parameter id="PresenceROI"/>
<parameter id="RefAngle"/>
<parameter id="RefColumn"/>
<parameter id="RefRow"/>
<parameter id="ReferenceImage"/>
<parameter id="Score"/>
<parameter id="SearchMinScore"/>
<parameter id="Status"/>
<parameter id="SurfaceROI"/>
</parameters>
</docu>
</procedure>
</hdevelop>
