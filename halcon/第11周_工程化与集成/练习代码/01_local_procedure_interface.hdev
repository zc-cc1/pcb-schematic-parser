<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第11周第1天：将算法封装成清晰的过程接口</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image,'fabrik')</l><c>* [逐行] 调用本程序的亮目标检测过程，并接收区域、状态和面积结果。</c>
<l>inspect_bright_parts (Image,SelectedRegions,180,80,999999,Status,Areas)</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image,Width,Height)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (SelectedRegions)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['过程状态：' + Status,'目标数量：' + |Areas|,'面积：',Areas], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure>
<procedure name="inspect_bright_parts"><interface><io><par name="Image" base_type="iconic" dimension="0"/></io><oo><par name="SelectedRegions" base_type="iconic" dimension="0"/></oo><ic><par name="ThresholdValue" base_type="ctrl" dimension="0"/><par name="MinArea" base_type="ctrl" dimension="0"/><par name="MaxArea" base_type="ctrl" dimension="0"/></ic><oc><par name="Status" base_type="ctrl" dimension="0"/><par name="Areas" base_type="ctrl" dimension="0"/></oc></interface><body><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (Image,BrightRegion,ThresholdValue,255)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>connection (BrightRegion,Connected)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>select_shape (Connected,SelectedRegions,'area','and',MinArea,MaxArea)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (SelectedRegions,Areas,Rows,Columns)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (|Areas| &gt; 0)</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>    Status := 'OK'</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>else</l><c>* [逐行] 设置检测状态变量 Status 的字符串值。</c>
<l>    Status := 'NO_OBJECT'</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l><c>* [逐行] 结束当前局部过程并把输出参数返回给调用方。</c>
<l>return ()</l></body><docu id="inspect_bright_parts"><parameters><parameter id="Areas"/><parameter id="Image"/><parameter id="MaxArea"/><parameter id="MinArea"/><parameter id="SelectedRegions"/><parameter id="Status"/><parameter id="ThresholdValue"/></parameters></docu></procedure></hdevelop>
