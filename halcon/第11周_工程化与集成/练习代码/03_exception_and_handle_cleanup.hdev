<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第11周第3天：异常信息与模型句柄生命周期</c>
<c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l>
<c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l>
<c>* [逐行] 设置布尔判定结果变量 ModelCreated 的初始真假状态。</c>
<l>ModelCreated := false</l>
<c>* [逐行] 设置检测状态变量 StatusCode 的数值初值或阈值。</c>
<l>StatusCode := 99</l>
<c>* [逐行] 设置检测状态变量 StatusText 的字符串值。</c>
<l>StatusText := 'UNINITIALIZED'</l>
<c>* [逐行] 开始受保护代码块，运行错误将交给catch分支处理。</c>
<l>try</l>
<c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>    read_image (Image,'rings_and_nuts')</l>
<c>* [逐行] 根据左上角和右下角坐标生成轴对齐矩形区域。</c>
<l>    gen_rectangle1 (ROI,60,60,200,200)</l>
<c>* [逐行] 把图像定义域限制到ROI；图像矩阵尺寸不变，但后续仅处理域内像素。</c>
<l>    reduce_domain (Image,ROI,TemplateImage)</l>
<c>* [逐行] 根据模板图像创建形状匹配模型并返回模型句柄。</c>
<l>    create_shape_model (TemplateImage,'auto',rad(-30),rad(60),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<c>* [逐行] 设置布尔判定结果变量 ModelCreated 的初始真假状态。</c>
<l>    ModelCreated := true</l>
<c>* [逐行] 在搜索图像中查找形状模型，返回位置、角度和匹配分数。</c>
<l>    find_shape_model (Image,ModelID,rad(-30),rad(60),0.5,1,0.5,'least_squares',0,0.8,Row,Column,Angle,Score)</l>
<c>* [逐行] 设置检测状态变量 StatusCode 的数值初值或阈值。</c>
<l>    StatusCode := 0</l>
<c>* [逐行] 设置检测状态变量 StatusText 的字符串值。</c>
<l>    StatusText := 'OK'</l>
<c>* [逐行] 捕获try代码块抛出的HALCON异常，并保存异常元组。</c>
<l>catch (Exception)</l>
<c>* [逐行] 从元组中读取指定元素或组合数据，并保存到 StatusCode。</c>
<l>    StatusCode := Exception[0]</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>    if (|Exception| &gt; 2)</l>
<c>* [逐行] 从元组中读取指定元素或组合数据，并保存到 StatusText。</c>
<l>        StatusText := Exception[2]</l>
<c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>    else</l>
<c>* [逐行] 设置检测状态变量 StatusText 的字符串值。</c>
<l>        StatusText := 'HALCON_EXCEPTION'</l>
<c>* [逐行] 结束当前条件分支。</c>
<l>    endif</l>
<c>* [逐行] 结束异常处理代码块。</c>
<l>endtry</l>
<c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (ModelCreated)</l>
<c>* [逐行] 释放形状模板句柄，避免模型资源泄漏。</c>
<l>    clear_shape_model (ModelID)</l>
<c>* [逐行] 结束当前条件分支。</c>
<l>endif</l>
<c>* [逐行] 创建指定尺寸和类型的常量图像，作为合成图像背景。</c>
<l>gen_image_const (DisplayImage,'byte',640,320)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,640,320,'black',WindowHandle)</l>
<c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (DisplayImage)</l>
<c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['状态码：' + StatusCode,'状态：' + StatusText,'模型创建：' + ModelCreated$'','模型句柄已在退出前释放'], 'window',12,12,'white',['box_color'],['black'])</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
