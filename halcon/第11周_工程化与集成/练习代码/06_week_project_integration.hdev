<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第11周项目：配置、批处理、过程接口、状态和耗时</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 设置文本或标识信息变量 ImageNames 的元组数据，供后续批量处理。</c>
<l>ImageNames := ['fabrik','mreut','rings_and_nuts']</l><c>* [逐行] 设置算法参数变量 ThresholdValue 的数值初值或阈值。</c>
<l>ThresholdValue := 180</l><c>* [逐行] 设置面积特征变量 MinArea 的数值初值或阈值。</c>
<l>MinArea := 80</l><c>* [逐行] 把控制变量变量 StatusCodes 初始化为空元组，供后续收集结果。</c>
<l>StatusCodes := []</l><c>* [逐行] 把计数或索引变量 ObjectCounts 初始化为空元组，供后续收集结果。</c>
<l>ObjectCounts := []</l><c>* [逐行] 把运行耗时变量 TimesMS 初始化为空元组，供后续收集结果。</c>
<l>TimesMS := []</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 0 to |ImageNames|-1 by 1</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T0)</l><c>* [逐行] 开始受保护代码块，运行错误将交给catch分支处理。</c>
<l>    try</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>        read_image (Image,ImageNames[I])</l><c>* [逐行] 调用本程序的工程化检测过程，并接收区域、状态码和特征结果。</c>
<l>        inspect_image (Image,ResultRegions,ThresholdValue,MinArea,StatusCode,Areas)</l><c>* [逐行] 捕获try代码块抛出的HALCON异常，并保存异常元组。</c>
<l>    catch (Exception)</l><c>* [逐行] 创建空的图形对象，作为无结果状态或对象收集器的初值。</c>
<l>        gen_empty_obj (ResultRegions)</l><c>* [逐行] 把面积特征变量 Areas 初始化为空元组，供后续收集结果。</c>
<l>        Areas := []</l><c>* [逐行] 设置检测状态变量 StatusCode 的数值初值或阈值。</c>
<l>        StatusCode := 20</l><c>* [逐行] 结束异常处理代码块。</c>
<l>    endtry</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T1)</l><c>* [逐行] 把本次结果追加到控制变量变量 StatusCodes 中。</c>
<l>    StatusCodes := [StatusCodes,StatusCode]</l><c>* [逐行] 把本次结果追加到计数或索引变量 ObjectCounts 中。</c>
<l>    ObjectCounts := [ObjectCounts,|Areas|]</l><c>* [逐行] 把本次结果追加到运行耗时变量 TimesMS 中。</c>
<l>    TimesMS := [TimesMS,(T1-T0)*1000]</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image,Width,Height)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (ResultRegions)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['第11周项目完成','输入：',ImageNames,'状态码：',StatusCodes,'目标数：',ObjectCounts,'耗时ms：',TimesMS$'.2f'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure>
<procedure name="inspect_image"><interface><io><par name="Image" base_type="iconic" dimension="0"/></io><oo><par name="ResultRegions" base_type="iconic" dimension="0"/></oo><ic><par name="ThresholdValue" base_type="ctrl" dimension="0"/><par name="MinArea" base_type="ctrl" dimension="0"/></ic><oc><par name="StatusCode" base_type="ctrl" dimension="0"/><par name="Areas" base_type="ctrl" dimension="0"/></oc></interface><body><c>* [逐行] 统计图像通道数量，用于判断灰度图或彩色图。</c>
<l>count_channels (Image,Channels)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (Channels == 3)</l><c>* [逐行] 按加权方式把三通道彩色图转换为单通道灰度图。</c>
<l>    rgb1_to_gray (Image,GrayImage)</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>else</l><c>* [逐行] 复制指定图形对象，得到独立的输出对象引用。</c>
<l>    copy_obj (Image,GrayImage,1,1)</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l><c>* [逐行] 使用邻域均值滤波图像，以降低局部噪声和灰度波动。</c>
<l>mean_image (GrayImage,Smoothed,5,5)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>threshold (Smoothed,BrightRegion,ThresholdValue,255)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>connection (BrightRegion,Connected)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>select_shape (Connected,ResultRegions,'area','and',MinArea,999999)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (ResultRegions,Areas,Rows,Columns)</l><c>* [逐行] 判断括号中的条件；条件为真时执行当前分支。</c>
<l>if (|Areas| &gt; 0)</l><c>* [逐行] 设置检测状态变量 StatusCode 的数值初值或阈值。</c>
<l>    StatusCode := 0</l><c>* [逐行] 前面的条件均不成立时执行这个分支。</c>
<l>else</l><c>* [逐行] 设置检测状态变量 StatusCode 的数值初值或阈值。</c>
<l>    StatusCode := 10</l><c>* [逐行] 结束当前条件分支。</c>
<l>endif</l><c>* [逐行] 结束当前局部过程并把输出参数返回给调用方。</c>
<l>return ()</l></body><docu id="inspect_image"><parameters><parameter id="Areas"/><parameter id="Image"/><parameter id="MinArea"/><parameter id="ResultRegions"/><parameter id="StatusCode"/><parameter id="ThresholdValue"/></parameters></docu></procedure></hdevelop>
