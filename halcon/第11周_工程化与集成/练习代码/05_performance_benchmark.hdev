<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第11周第5天：预热后统计100次处理耗时</c><c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 读取指定图像文件或HALCON示例图像，并保存到输出图像变量。</c>
<l>read_image (Image,'fabrik')</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for Warmup := 1 to 5 by 1</l><c>* [逐行] 使用邻域均值滤波图像，以降低局部噪声和灰度波动。</c>
<l>    mean_image (Image,Smoothed,5,5)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>    threshold (Smoothed,Region,170,255)</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 把运行耗时变量 TimesMS 初始化为空元组，供后续收集结果。</c>
<l>TimesMS := []</l><c>* [逐行] 把计数或索引变量 Counts 初始化为空元组，供后续收集结果。</c>
<l>Counts := []</l><c>* [逐行] 按照给定起点、终点和步长开始循环处理。</c>
<l>for I := 1 to 100 by 1</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T0)</l><c>* [逐行] 使用邻域均值滤波图像，以降低局部噪声和灰度波动。</c>
<l>    mean_image (Image,Smoothed,5,5)</l><c>* [逐行] 按灰度上下限对图像做阈值分割，生成满足条件的区域。</c>
<l>    threshold (Smoothed,Region,170,255)</l><c>* [逐行] 把一个区域按连通性拆分成多个互不相连的区域。</c>
<l>    connection (Region,Connected)</l><c>* [逐行] 按照面积、宽高或其他形状特征筛选连通区域。</c>
<l>    select_shape (Connected,Selected,'area','and',80,999999)</l><c>* [逐行] 统计图形对象数组中的对象数量。</c>
<l>    count_obj (Selected,Count)</l><c>* [逐行] 读取当前高精度时间，用于计算程序运行耗时。</c>
<l>    count_seconds (T1)</l><c>* [逐行] 把本次结果追加到运行耗时变量 TimesMS 中。</c>
<l>    TimesMS := [TimesMS,(T1-T0)*1000]</l><c>* [逐行] 把本次结果追加到计数或索引变量 Counts 中。</c>
<l>    Counts := [Counts,Count]</l><c>* [逐行] 结束当前for循环，继续执行循环后的代码。</c>
<l>endfor</l><c>* [逐行] 对数值元组升序排序，供中位数或分位耗时计算使用。</c>
<l>tuple_sort (TimesMS,SortedTimes)</l><c>* [逐行] 根据当前数据计算运行耗时，并把结果保存到 P95Index。</c>
<l>P95Index := floor(0.95*(|SortedTimes|-1))</l><c>* [逐行] 读取图像宽度和高度，供窗口、ROI或边界计算使用。</c>
<l>get_image_size (Image,Width,Height)</l><c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Image)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle,['100次性能测试','平均：' + mean(TimesMS)$'.3f' + ' ms','最小/最大：' + min(TimesMS)$'.3f' + ' / ' + max(TimesMS)$'.3f' + ' ms','P95：' + SortedTimes[P95Index]$'.3f' + ' ms'], 'window',12,12,'white',['box_color'],['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
