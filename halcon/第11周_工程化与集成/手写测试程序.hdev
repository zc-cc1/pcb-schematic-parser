<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<c></c>
<l>ImageNames := ['fabrik','mreut','rings_and_nuts']</l>
<l>ThresholdValue := 180</l>
<l>MinArea := 80</l>
<l>StatusCodes := []</l>
<l>ObjectCounts :=[]</l>
<l>TimesMS :=[]</l>
<c></c>
<l>for I:=0 to |ImageNames|-1 by 1</l>
<l>    count_seconds (T0)</l>
<l>    try</l>
<l>        read_image (Image, ImageNames[I])</l>
<l>        inspect_image (Image, ResultRegions, ThresholdValue, MinArea, StatusCode, Areas)</l>
<l>    catch (Exception)</l>
<l>        gen_empty_obj (ResultRegions)</l>
<l>        Areas :=[]</l>
<l>        StatusCode :=20</l>
<l>    endtry</l>
<l>    count_seconds (T1)</l>
<l>    StatusCodes :=[StatusCodes,StatusCode]</l>
<l>    ObjectCounts :=[ObjectCounts,|Areas|]</l>
<l>    TimesMS :=[TimesMS,(T1-T0)*1000]</l>
<l>endfor</l>
<l>get_image_size (Image, Width, Height)</l>
<l>dev_open_window (0, 0, Width, Height, 'black', WindowHandle)</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_color ('green')</l>
<l>dev_display (ResultRegions)</l>
<c></c>
<c></c>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
<procedure name="inspect_image">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ResultRegions" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ThresholdValue" base_type="ctrl" dimension="0"/>
<par name="MinArea" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="StatusCode" base_type="ctrl" dimension="0"/>
<par name="Areas" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_channels (Image, Channels)</l>
<l>if(Channels == 3)</l>
<l>    rgb1_to_gray (Image, GrayImage)</l>
<l>else</l>
<l>    copy_obj (Image, GrayImage, 1, 1)</l>
<l>endif</l>
<c></c>
<l>mean_image(GrayImage,Smoothed,5,5)</l>
<l>threshold (Smoothed, BrightRegion, ThresholdValue, 255)</l>
<l>connection (BrightRegion, Connected)</l>
<l>select_shape (Connected, ResultRegions, 'area', 'and', MinArea, 99999)</l>
<l>area_center (ResultRegions, Areas, Rows, Columns)</l>
<c></c>
<l>if(|Areas|&gt;0)</l>
<l>    StatusCode :=0</l>
<l>else</l>
<l>    StatusCode := 10</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="inspect_image">
<parameters>
<parameter id="Areas"/>
<parameter id="Image"/>
<parameter id="MinArea"/>
<parameter id="ResultRegions"/>
<parameter id="StatusCode"/>
<parameter id="ThresholdValue"/>
</parameters>
</docu>
</procedure>
</hdevelop>
