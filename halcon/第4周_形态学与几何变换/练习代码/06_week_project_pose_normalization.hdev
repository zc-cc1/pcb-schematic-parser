<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main"><interface/><body>
<c>* 第4周项目：区域修复与姿态归一化</c>
<c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l>
<c>* [逐行] 根据中心、方向和两个半边长生成可旋转矩形区域。</c>
<l>gen_rectangle2 (Part, 285, 225, rad(32), 135, 55)</l><c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>gen_circle (Hole, 285, 225, 18)</l><c>* [逐行] 计算两个区域的差集，保留第一个区域中不属于第二个区域的部分。</c>
<l>difference (Part, Hole, PartWithHole)</l>
<c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>gen_circle (Noise, 105, 430, 7)</l><c>* [逐行] 合并两个区域，得到它们的并集。</c>
<l>union2 (PartWithHole, Noise, InputRegion)</l>
<c>* [逐行] 使用圆形结构元素做开运算，以去除小区域和细小连接。</c>
<l>opening_circle (InputRegion, Cleaned, 10.5)</l><c>* [逐行] 填充区域内部完全封闭的孔洞。</c>
<l>fill_up (Cleaned, Repaired)</l>
<c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (Repaired, Area, CenterRow, CenterColumn)</l><c>* [逐行] 计算区域主方向角，用于姿态归一化。</c>
<l>orientation_region (Repaired, Orientation)</l>
<c>* [逐行] 根据参考位姿和当前位姿建立二维刚性变换矩阵。</c>
<l>vector_angle_to_rigid (CenterRow, CenterColumn, Orientation, 256, 256, 0, HomNormalize)</l>
<c>* [逐行] 使用仿射矩阵变换区域，使检测ROI跟随目标移动。</c>
<l>affine_trans_region (Repaired, NormalizedRegion, HomNormalize, 'nearest_neighbor')</l>
<c>* [逐行] 把区域转换为二值图像，并为区域内外分别设置灰度值。</c>
<l>region_to_bin (InputRegion, InputImage, 220, 25, 512, 512)</l><c>* [逐行] 使用仿射矩阵变换整幅图像，得到旋转或平移后的图像。</c>
<l>affine_trans_image (InputImage, NormalizedImage, HomNormalize, 'constant', 'false')</l>
<c>* [逐行] 根据中心、方向和两个半边长生成可旋转矩形区域。</c>
<l>gen_rectangle2 (InspectionROI, CenterRow, CenterColumn + 75, Orientation, 25, 18)</l><c>* [逐行] 使用仿射矩阵变换区域，使检测ROI跟随目标移动。</c>
<l>affine_trans_region (InspectionROI, NormalizedROI, HomNormalize, 'nearest_neighbor')</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0, 0, 640, 520, 'black', WindowHandle)</l><c>* [逐行] 设置图像坐标与窗口显示区域的对应范围。</c>
<l>dev_set_part (0, 0, 511, 511)</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (InputImage)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (4)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (InspectionROI)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['原始姿态','中心：' + CenterRow$'.1f' + ', ' + CenterColumn$'.1f','方向：' + deg(Orientation)$'.2f' + ' deg'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l><c>* [逐行] 暂停程序，便于在HDevelop中观察当前中间结果。</c>
<l>stop ()</l>
<c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (NormalizedImage)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (NormalizedRegion)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (NormalizedROI)</l><c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['姿态归一化完成','目标中心移到(256,256)','方向校正为0，ROI同步变换'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
