<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main"><interface/><body>
<c>* 第4周第4天：仿射矩阵组合顺序</c>
<c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l><c>* [逐行] 根据中心、方向和两个半边长生成可旋转矩形区域。</c>
<l>gen_rectangle2 (Region, 180, 180, rad(20), 90, 35)</l>
<c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>hom_mat2d_identity (H0)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>hom_mat2d_rotate (H0, rad(45), 180, 180, HRotate)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>hom_mat2d_translate (HRotate, 140, 170, HRotateThenTranslate)</l>
<c>* [逐行] 创建二维单位变换矩阵，作为后续旋转和平移的起点。</c>
<l>hom_mat2d_identity (H1)</l><c>* [逐行] 在当前二维矩阵上加入行列方向的平移变换。</c>
<l>hom_mat2d_translate (H1, 140, 170, HTranslate)</l><c>* [逐行] 在当前二维矩阵上加入绕指定中心的旋转变换。</c>
<l>hom_mat2d_rotate (HTranslate, rad(45), 180, 180, HTranslateThenRotate)</l>
<c>* [逐行] 使用仿射矩阵变换区域，使检测ROI跟随目标移动。</c>
<l>affine_trans_region (Region, ResultA, HRotateThenTranslate, 'nearest_neighbor')</l><c>* [逐行] 使用仿射矩阵变换区域，使检测ROI跟随目标移动。</c>
<l>affine_trans_region (Region, ResultB, HTranslateThenRotate, 'nearest_neighbor')</l>
<c>* [逐行] 使用二维仿射矩阵变换点坐标，计算点的新位置。</c>
<l>affine_trans_point_2d (HRotateThenTranslate, 180, 180, RowA, ColA)</l><c>* [逐行] 使用二维仿射矩阵变换点坐标，计算点的新位置。</c>
<l>affine_trans_point_2d (HTranslateThenRotate, 180, 180, RowB, ColB)</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0, 0, 650, 550, 'black', WindowHandle)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (4)</l>
<c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('white')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Region)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (ResultA)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('red')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (ResultB)</l>
<c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, ['白：原始','绿：先旋转再平移','红：先平移再旋转','结果A中心：' + RowA$'.1f' + ', ' + ColA$'.1f','结果B中心：' + RowB$'.1f' + ', ' + ColB$'.1f','矩阵组合顺序会改变结果'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
