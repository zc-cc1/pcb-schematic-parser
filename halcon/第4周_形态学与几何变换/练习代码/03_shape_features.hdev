<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main"><interface/><body>
<c>* 第4周第3天：用特征验证形态学副作用</c>
<c>* [逐行] 关闭HDevelop自动更新，避免逐条执行时产生不必要的刷新。</c>
<l>dev_update_off ()</l><c>* [逐行] 关闭当前HDevelop图形窗口，防止重复运行时窗口不断累积。</c>
<l>dev_close_window ()</l>
<c>* [逐行] 根据中心、方向和半轴长度生成椭圆区域。</c>
<l>gen_ellipse (Original, 250, 250, rad(25), 150, 75)</l>
<c>* [逐行] 根据圆心和半径生成圆形区域。</c>
<l>gen_circle (Notch, 250, 365, 20)</l><c>* [逐行] 计算两个区域的差集，保留第一个区域中不属于第二个区域的部分。</c>
<l>difference (Original, Notch, Defective)</l>
<c>* [逐行] 使用圆形结构元素做闭运算，以连接小间隙并填补小孔。</c>
<l>closing_circle (Defective, Repaired, 22.5)</l>
<c>* [逐行] 把区域转换成指定标准外形，例如最小外接矩形。</c>
<l>shape_trans (Repaired, ConvexHull, 'convex')</l>
<c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (Original, AreaOriginal, RowO, ColO)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (Defective, AreaDefective, RowD, ColD)</l><c>* [逐行] 计算区域面积及其重心行列坐标，并写入输出变量。</c>
<l>area_center (Repaired, AreaRepaired, RowR, ColR)</l>
<c>* [逐行] 计算区域圆度，数值越接近1通常越接近圆形。</c>
<l>circularity (Original, CircularityOriginal)</l><c>* [逐行] 计算区域圆度，数值越接近1通常越接近圆形。</c>
<l>circularity (Repaired, CircularityRepaired)</l>
<c>* [逐行] 根据当前参数和中间结果计算面积特征变量 AreaErrorPercent。</c>
<l>AreaErrorPercent := 100.0 * (AreaRepaired - AreaOriginal) / AreaOriginal</l>
<c>* [逐行] 按照给定位置和尺寸打开HDevelop图形窗口，并取得窗口句柄。</c>
<l>dev_open_window (0, 0, 600, 520, 'black', WindowHandle)</l><c>* [逐行] 设置区域按填充或轮廓方式显示。</c>
<l>dev_set_draw ('margin')</l><c>* [逐行] 设置后续轮廓和区域边界的显示线宽。</c>
<l>dev_set_line_width (4)</l>
<c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('white')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Defective)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('green')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (Repaired)</l><c>* [逐行] 设置后续图形对象的显示颜色。</c>
<l>dev_set_color ('yellow')</l><c>* [逐行] 把当前图像、区域或XLD对象显示到活动图形窗口。</c>
<l>dev_display (ConvexHull)</l>
<c>* [逐行] 设置文本或标识信息变量 Text 的元组数据，供后续批量处理。</c>
<l>Text := ['白：缺口区域','绿：闭运算修复','黄：凸包','原面积：' + AreaOriginal,'修复面积：' + AreaRepaired,'面积偏差：' + AreaErrorPercent$'.2f' + ' %','圆度：' + CircularityOriginal$'.3f' + ' -&gt; ' + CircularityRepaired$'.3f']</l>
<c>* [逐行] 在指定窗口位置显示说明文字、参数或检测结果。</c>
<l>disp_text (WindowHandle, Text, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
