<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第二周第2天：ROI、定义域与真实裁剪</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'fabrik')</l>
<l>get_image_size (Image, OriginalWidth, OriginalHeight)</l>
<l>CenterRow := 256</l>
<l>CenterColumn := 256</l>
<l>Radius := 50</l>
<l>gen_circle (CircleROI, CenterRow, CenterColumn, Radius)</l>
<l>reduce_domain (Image, CircleROI, ImageReduced)</l>
<l>get_image_size (ImageReduced, ReducedWidth, ReducedHeight)</l>
<l>get_domain (ImageReduced, ReducedDomain)</l>
<l>area_center (ReducedDomain, DomainArea, DomainCenterRow, DomainCenterColumn)</l>
<l>full_domain (ImageReduced, ImageFullAgain)</l>
<l>crop_domain (ImageReduced, ImageCroppedDomain)</l>
<l>get_image_size (ImageCroppedDomain, CroppedWidth, CroppedHeight)</l>
<l>Row1 := CenterRow - Radius</l>
<l>Column1 := CenterColumn - Radius</l>
<l>Row2 := CenterRow + Radius</l>
<l>Column2 := CenterColumn + Radius</l>
<l>crop_rectangle1 (Image, ImageCroppedRectangle, Row1, Column1, Row2, Column2)</l>
<l>get_image_size (ImageCroppedRectangle, RectangleWidth, RectangleHeight)</l>
<l>dev_open_window (0, 0, 640, 520, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, OriginalHeight - 1, OriginalWidth - 1)</l>
<l>dev_display (Image)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (4)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (CircleROI)</l>
<l>disp_text (WindowHandle, ['原图与圆形ROI', '原图尺寸：' + OriginalWidth + ' x ' + OriginalHeight], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, OriginalHeight - 1, OriginalWidth - 1)</l>
<l>dev_display (ImageReduced)</l>
<l>disp_text (WindowHandle, ['reduce_domain结果', '矩阵尺寸仍为：' + ReducedWidth + ' x ' + ReducedHeight, 'ROI外只是无效，并非灰度值0'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_display (ImageFullAgain)</l>
<l>disp_text (WindowHandle, 'full_domain后ROI外原始像素重新显示', 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, CroppedHeight - 1, CroppedWidth - 1)</l>
<l>dev_display (ImageCroppedDomain)</l>
<l>disp_text (WindowHandle, ['crop_domain结果', '新矩阵尺寸：' + CroppedWidth + ' x ' + CroppedHeight, '定义域仍来自圆形ROI'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, RectangleHeight - 1, RectangleWidth - 1)</l>
<l>dev_display (ImageCroppedRectangle)</l>
<l>disp_text (WindowHandle, ['crop_rectangle1结果', '新矩阵尺寸：' + RectangleWidth + ' x ' + RectangleHeight, '按明确矩形坐标裁剪'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
