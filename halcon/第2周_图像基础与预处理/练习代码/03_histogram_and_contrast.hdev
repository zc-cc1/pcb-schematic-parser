<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.1" halcon_version="20.11.0.0">
<procedure name="main">
<interface/>
<body>
<c>* 第二周第3天：灰度直方图与对比度增强</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'fabrik')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>get_domain (Image, FullDomain)</l>
<c>* 人为压缩灰度范围，生成低对比度图像</c>
<l>scale_image (Image, LowContrastImage, 0.3, 80)</l>
<l>min_max_gray (FullDomain, LowContrastImage, 0, MinLow, MaxLow, RangeLow)</l>
<l>intensity (FullDomain, LowContrastImage, MeanLow, DeviationLow)</l>
<l>gray_histo (FullDomain, LowContrastImage, AbsoluteHistoLow, RelativeHistoLow)</l>
<c>* 将直方图高度缩放到200像素，仅用于可视化</c>
<l>MaxBinLow := max(AbsoluteHistoLow)</l>
<l>tuple_int (AbsoluteHistoLow * 200.0 / MaxBinLow, DisplayHistoLow)</l>
<l>gen_region_histo (HistogramLow, DisplayHistoLow, 230, 128, 1)</l>
<c>* 将有效灰度范围线性拉伸到0到255</c>
<l>if (RangeLow &gt; 0)</l>
<l>    ScaleFactor := 255.0 / RangeLow</l>
<l>    Offset := -MinLow * ScaleFactor</l>
<l>    scale_image (LowContrastImage, EnhancedImage, ScaleFactor, Offset)</l>
<l>else</l>
<l>    ScaleFactor := 1.0</l>
<l>    Offset := 0.0</l>
<l>    copy_image (LowContrastImage, EnhancedImage)</l>
<l>endif</l>
<l>min_max_gray (FullDomain, EnhancedImage, 0, MinEnhanced, MaxEnhanced, RangeEnhanced)</l>
<l>intensity (FullDomain, EnhancedImage, MeanEnhanced, DeviationEnhanced)</l>
<l>gray_histo (FullDomain, EnhancedImage, AbsoluteHistoEnhanced, RelativeHistoEnhanced)</l>
<l>MaxBinEnhanced := max(AbsoluteHistoEnhanced)</l>
<l>tuple_int (AbsoluteHistoEnhanced * 200.0 / MaxBinEnhanced, DisplayHistoEnhanced)</l>
<l>gen_region_histo (HistogramEnhanced, DisplayHistoEnhanced, 230, 128, 1)</l>
<l>dev_open_window (0, 0, 640, 520, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (LowContrastImage)</l>
<l>InfoLow := ['低对比度图像', '最小灰度：' + MinLow$'.1f', '最大灰度：' + MaxLow$'.1f', '灰度范围：' + RangeLow$'.1f', '标准差：' + DeviationLow$'.2f']</l>
<l>disp_text (WindowHandle, InfoLow, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, 255, 255)</l>
<l>dev_set_color ('orange')</l>
<l>dev_set_draw ('fill')</l>
<l>dev_display (HistogramLow)</l>
<l>disp_text (WindowHandle, ['低对比度图像直方图', '横轴：灰度0到255', '纵轴：像素数量（显示高度已归一化）'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (EnhancedImage)</l>
<l>InfoEnhanced := ['线性拉伸后的图像', '最小灰度：' + MinEnhanced$'.1f', '最大灰度：' + MaxEnhanced$'.1f', '灰度范围：' + RangeEnhanced$'.1f', '标准差：' + DeviationEnhanced$'.2f', 'Scale：' + ScaleFactor$'.3f', 'Offset：' + Offset$'.3f']</l>
<l>disp_text (WindowHandle, InfoEnhanced, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_clear_window ()</l>
<l>dev_set_part (0, 0, 255, 255)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (HistogramEnhanced)</l>
<l>disp_text (WindowHandle, ['增强后图像直方图', '灰度分布范围明显变宽'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
