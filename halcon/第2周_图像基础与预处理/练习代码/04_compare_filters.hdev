<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 第二周第4天：均值、高斯和中值滤波对比</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image, 'fabrik')</l>
<l>get_image_size (Image, Width, Height)</l>
<l>get_domain (Image, FullDomain)</l>
<c>* 生成椒盐噪声：5%白点和5%黑点</c>
<l>sp_distribution (20, 5, NoiseDistribution)</l>
<l>add_noise_distribution (Image, NoisyImage, NoiseDistribution)</l>
<c>* 分别计时三种滤波</c>
<l>count_seconds (TimeStart)</l>
<l>mean_image (NoisyImage, MeanImage, 5, 5)</l>
<l>count_seconds (TimeEnd)</l>
<l>MeanTimeMs := (TimeEnd - TimeStart) * 1000.0</l>
<l>count_seconds (TimeStart)</l>
<l>gauss_filter (NoisyImage, GaussImage, 5)</l>
<l>count_seconds (TimeEnd)</l>
<l>GaussTimeMs := (TimeEnd - TimeStart) * 1000.0</l>
<l>count_seconds (TimeStart)</l>
<l>median_image (NoisyImage, MedianImage, 'circle', 3, 'mirrored')</l>
<l>count_seconds (TimeEnd)</l>
<l>MedianTimeMs := (TimeEnd - TimeStart) * 1000.0</l>
<c>* 计算结果与无噪声原图的平均绝对误差</c>
<l>abs_diff_image (Image, NoisyImage, DifferenceNoisy, 1)</l>
<l>abs_diff_image (Image, MeanImage, DifferenceMean, 1)</l>
<l>abs_diff_image (Image, GaussImage, DifferenceGauss, 1)</l>
<l>abs_diff_image (Image, MedianImage, DifferenceMedian, 1)</l>
<l>intensity (FullDomain, DifferenceNoisy, ErrorNoisy, ErrorNoisyDeviation)</l>
<l>intensity (FullDomain, DifferenceMean, ErrorMean, ErrorMeanDeviation)</l>
<l>intensity (FullDomain, DifferenceGauss, ErrorGauss, ErrorGaussDeviation)</l>
<l>intensity (FullDomain, DifferenceMedian, ErrorMedian, ErrorMedianDeviation)</l>
<l>dev_open_window (0, 0, 640, 520, 'black', WindowHandle)</l>
<l>dev_set_part (0, 0, Height - 1, Width - 1)</l>
<l>dev_display (Image)</l>
<l>disp_text (WindowHandle, '无噪声参考图', 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_display (NoisyImage)</l>
<l>disp_text (WindowHandle, ['椒盐噪声图', '平均绝对误差：' + ErrorNoisy$'.2f'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_display (MeanImage)</l>
<l>disp_text (WindowHandle, ['均值滤波 5 x 5', '平均绝对误差：' + ErrorMean$'.2f', '耗时：' + MeanTimeMs$'.3f' + ' ms'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_display (GaussImage)</l>
<l>disp_text (WindowHandle, ['高斯滤波 Size=5', '平均绝对误差：' + ErrorGauss$'.2f', '耗时：' + GaussTimeMs$'.3f' + ' ms'], 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
<l>stop ()</l>
<l>dev_display (MedianImage)</l>
<l>SummaryText := ['中值滤波 circle, Radius=2', '平均绝对误差：' + ErrorMedian$'.2f', '耗时：' + MedianTimeMs$'.3f' + ' ms', '', '三种误差越小越接近参考图', '仍需同时检查边缘和小目标']</l>
<l>disp_text (WindowHandle, SummaryText, 'window', 12, 12, 'white', ['box_color'], ['black'])</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
