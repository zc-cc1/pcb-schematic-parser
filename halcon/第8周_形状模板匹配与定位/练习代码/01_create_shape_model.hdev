<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第8周第1天：选择稳定模板ROI，创建并检查形状模型。</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image,'rings_and_nuts')</l>
<l>get_image_size (Image,Width,Height)</l>
<c>* 原齿轮接近旋转对称；这里加一个方向特征，模拟真实零件上的缺口、键槽或定位标记。</c>
<l>gen_circle (DirectionMark,130,190,12)</l>
<l>paint_region (DirectionMark,Image,MarkedImage,0,'fill')</l>
<c>* ROI只包住一个目标及其方向特征，避免把其他零件和大片背景建进模型。</c>
<l>gen_rectangle1 (TemplateROI,60,60,200,210)</l>
<l>reduce_domain (MarkedImage,TemplateROI,TemplateImage)</l>
<c>* 允许目标在-45到+45度范围内旋转；use_polarity要求明暗极性一致。</c>
<l>count_seconds (CreateT0)</l>
<l>create_shape_model (TemplateImage,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<l>count_seconds (CreateT1)</l>
<l>get_shape_model_contours (ModelContours,ModelID,1)</l>
<l>length_xld (ModelContours,ContourLengths)</l>
<c>* 先在参考图上回查一次；接近1的分数说明模板能够正确回到建模对象。</c>
<l>find_shape_model (MarkedImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,Row,Column,Angle,Score)</l>
<l>vector_angle_to_rigid (0,0,0,Row[0],Column[0],Angle[0],ContourTransform)</l>
<l>affine_trans_contour_xld (ModelContours,ModelContoursOnImage,ContourTransform)</l>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l>
<l>dev_display (MarkedImage)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('green')</l>
<l>dev_display (TemplateROI)</l>
<l>dev_set_color ('yellow')</l>
<l>dev_display (ModelContoursOnImage)</l>
<l>disp_text (WindowHandle,['第1天实验已完成','绿色=模板ROI；黄色=模型轮廓','参考Row/Column=' + Row[0]$'.3f' + ' / ' + Column[0]$'.3f','参考角度=' + deg(Angle[0])$'.3f' + '度','Score=' + Score[0]$'.6f','建模耗时=' + ((CreateT1-CreateT0)*1000)$'.2f' + ' ms','轮廓总长度=' + sum(ContourLengths)$'.1f' + ' px'], 'window',12,12,'white',['box_color'],['black'])</l>
<l>clear_shape_model (ModelID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
