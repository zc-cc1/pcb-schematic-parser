<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第8周第2天：把0个、1个和多个匹配结果全部处理清楚。</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image,'rings_and_nuts')</l>
<l>get_image_size (Image,Width,Height)</l>
<l>gen_rectangle1 (TemplateROI,60,60,200,200)</l>
<l>reduce_domain (Image,TemplateROI,TemplateImage)</l>
<l>create_shape_model (TemplateImage,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<c>* 0个结果：在纯黑图中搜索，输出元组应为空。</c>
<l>gen_image_const (BlankImage,'byte',Width,Height)</l>
<l>find_shape_model (BlankImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,ZeroRow,ZeroColumn,ZeroAngle,ZeroScore)</l>
<c>* 1个结果：提高MinScore并只取最好结果。</c>
<l>find_shape_model (Image,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,OneRow,OneColumn,OneAngle,OneScore)</l>
<c>* 多个结果：降低MinScore并允许最多10个结果；本图实测得到3个候选。</c>
<l>find_shape_model (Image,ModelID,rad(-45),rad(90),0.3,10,0.5,'least_squares',0,0.8,MultiRow,MultiColumn,MultiAngle,MultiScore)</l>
<c>* 工程写法：先判断|Score|，再访问Score[0]，否则无匹配时会越界。</c>
<l>if (|ZeroScore| == 0)</l>
<l>    ZeroStatus := 'NO_MATCH'</l>
<l>else</l>
<l>    ZeroStatus := 'UNEXPECTED_MATCH'</l>
<l>endif</l>
<l>if (|OneScore| == 1)</l>
<l>    OneStatus := 'ONE_MATCH'</l>
<l>else</l>
<l>    OneStatus := 'CHECK_RESULT_COUNT'</l>
<l>endif</l>
<l>if (|MultiScore| &gt; 1)</l>
<l>    MultiStatus := 'MULTI_MATCH'</l>
<l>else</l>
<l>    MultiStatus := 'NOT_ENOUGH_CANDIDATES'</l>
<l>endif</l>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l>
<l>dev_display (Image)</l>
<l>gen_cross_contour_xld (Crosses,MultiRow,MultiColumn,18,MultiAngle)</l>
<l>dev_set_color ('green')</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (Crosses)</l>
<l>disp_text (WindowHandle,['第2天实验已完成','0结果：' + ZeroStatus + '，数量=' + |ZeroScore|,'1结果：' + OneStatus + '，Score=' + OneScore[0]$'.6f','多结果：' + MultiStatus + '，数量=' + |MultiScore|,'多结果分数=' + MultiScore$'.3f','结论：匹配成功、匹配唯一、业务可接受是三件事'], 'window',12,12,'white',['box_color'],['black'])</l>
<l>clear_shape_model (ModelID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
