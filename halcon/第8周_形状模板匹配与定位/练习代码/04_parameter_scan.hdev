<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第8周第4天：固定其他条件，一次只扫描一个模板匹配参数。</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image,'rings_and_nuts')</l>
<l>get_image_size (Image,Width,Height)</l>
<c>* 无方向标记模型用于观察低分候选和MaxOverlap；带标记模型用于验证唯一角度。</c>
<l>gen_rectangle1 (UnmarkedROI,60,60,200,200)</l>
<l>reduce_domain (Image,UnmarkedROI,UnmarkedTemplate)</l>
<l>create_shape_model (UnmarkedTemplate,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',UnmarkedModelID)</l>
<l>gen_circle (DirectionMark,130,190,12)</l>
<l>paint_region (DirectionMark,Image,MarkedImage,0,'fill')</l>
<l>gen_rectangle1 (TemplateROI,60,60,200,210)</l>
<l>reduce_domain (MarkedImage,TemplateROI,TemplateImage)</l>
<l>create_shape_model (TemplateImage,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<l>find_shape_model (MarkedImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,RefRow,RefColumn,RefAngle,RefScore)</l>
<c>* 测试图真值：围绕目标中心旋转24度，再平移Row+10、Column-8。</c>
<l>hom_mat2d_identity (KnownMove)</l>
<l>hom_mat2d_rotate (KnownMove,rad(24),RefRow,RefColumn,KnownMove)</l>
<l>hom_mat2d_translate (KnownMove,10,-8,KnownMove)</l>
<l>affine_trans_image (MarkedImage,ParameterImage,KnownMove,'constant','false')</l>
<l>affine_trans_point_2d (KnownMove,RefRow,RefColumn,ExpectedRow,ExpectedColumn)</l>
<c>* 1. 角度总范围：每种范围同时用于建模和搜索，避免只改搜索参数造成误解。</c>
<l>AngleExtents := [20,40,60,90]</l>
<l>AngleFound := []</l>
<l>AngleCorrect := []</l>
<l>AngleReturned := []</l>
<l>AngleTimes := []</l>
<l>for J := 0 to |AngleExtents|-1 by 1</l>
<l>    create_shape_model (TemplateImage,'auto',rad(-AngleExtents[J]/2),rad(AngleExtents[J]),'auto','auto','use_polarity','auto','auto',AngleModelID)</l>
<l>    TimeSum := 0</l>
<l>    for K := 0 to 19 by 1</l>
<l>        count_seconds (T0)</l>
<l>        find_shape_model (ParameterImage,AngleModelID,rad(-AngleExtents[J]/2),rad(AngleExtents[J]),0.5,1,0.5,'least_squares',0,0.8,R,C,A,S)</l>
<l>        count_seconds (T1)</l>
<l>        TimeSum := TimeSum+(T1-T0)*1000</l>
<l>    endfor</l>
<l>    AngleFound := [AngleFound,|S|]</l>
<l>    if (|S| &gt; 0)</l>
<l>        PositionError := sqrt((R[0]-ExpectedRow)*(R[0]-ExpectedRow)+(C[0]-ExpectedColumn)*(C[0]-ExpectedColumn))</l>
<l>        AngleError := abs(deg(A[0])-24)</l>
<l>        AngleReturned := [AngleReturned,deg(A[0])]</l>
<l>        if (PositionError &lt;= 5 and AngleError &lt;= 3)</l>
<l>            AngleCorrect := [AngleCorrect,1]</l>
<l>        else</l>
<l>            AngleCorrect := [AngleCorrect,0]</l>
<l>        endif</l>
<l>    else</l>
<l>        AngleReturned := [AngleReturned,999]</l>
<l>        AngleCorrect := [AngleCorrect,0]</l>
<l>    endif</l>
<l>    AngleTimes := [AngleTimes,TimeSum/20.0]</l>
<l>    clear_shape_model (AngleModelID)</l>
<l>endfor</l>
<c>* 2. MinScore：阈值越低，候选越多；本图0.3时实测出现3个候选。</c>
<l>MinScores := [0.3,0.5,0.7,0.85]</l>
<l>ScoreCounts := []</l>
<l>ScoreTimes := []</l>
<l>for J := 0 to |MinScores|-1 by 1</l>
<l>    TimeSum := 0</l>
<l>    for K := 0 to 19 by 1</l>
<l>        count_seconds (T0)</l>
<l>        find_shape_model (Image,UnmarkedModelID,rad(-45),rad(90),MinScores[J],10,0.5,'least_squares',0,0.8,R,C,A,S)</l>
<l>        count_seconds (T1)</l>
<l>        TimeSum := TimeSum+(T1-T0)*1000</l>
<l>    endfor</l>
<l>    ScoreCounts := [ScoreCounts,|S|]</l>
<l>    ScoreTimes := [ScoreTimes,TimeSum/20.0]</l>
<l>endfor</l>
<c>* 3. NumLevels：0为自动；1只在最精细层搜索，本机实测反而明显更慢。</c>
<l>LevelValues := [0,1,2,3]</l>
<l>LevelFound10 := []</l>
<l>LevelTimes := []</l>
<l>for J := 0 to |LevelValues|-1 by 1</l>
<l>    TimeSum := 0</l>
<l>    FoundSum := 0</l>
<l>    for K := 0 to 9 by 1</l>
<l>        count_seconds (T0)</l>
<l>        find_shape_model (ParameterImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',LevelValues[J],0.8,R,C,A,S)</l>
<l>        count_seconds (T1)</l>
<l>        TimeSum := TimeSum+(T1-T0)*1000</l>
<l>        FoundSum := FoundSum+|S|</l>
<l>    endfor</l>
<l>    LevelFound10 := [LevelFound10,FoundSum]</l>
<l>    LevelTimes := [LevelTimes,TimeSum/10.0]</l>
<l>endfor</l>
<c>* 4. Greediness：越高通常越快，但困难样本可能更容易被提前放弃。</c>
<l>GreedValues := [0.3,0.5,0.7,0.9]</l>
<l>GreedFound10 := []</l>
<l>GreedTimes := []</l>
<l>for J := 0 to |GreedValues|-1 by 1</l>
<l>    TimeSum := 0</l>
<l>    FoundSum := 0</l>
<l>    for K := 0 to 9 by 1</l>
<l>        count_seconds (T0)</l>
<l>        find_shape_model (ParameterImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,GreedValues[J],R,C,A,S)</l>
<l>        count_seconds (T1)</l>
<l>        TimeSum := TimeSum+(T1-T0)*1000</l>
<l>        FoundSum := FoundSum+|S|</l>
<l>    endfor</l>
<l>    GreedFound10 := [GreedFound10,FoundSum]</l>
<l>    GreedTimes := [GreedTimes,TimeSum/10.0]</l>
<l>endfor</l>
<c>* 5. MaxOverlap：当前3个候选彼此分离，因此四种设置结果相同。</c>
<l>OverlapValues := [0.0,0.3,0.5,0.8]</l>
<l>OverlapCounts := []</l>
<l>for J := 0 to |OverlapValues|-1 by 1</l>
<l>    find_shape_model (Image,UnmarkedModelID,rad(-45),rad(90),0.3,10,OverlapValues[J],'least_squares',0,0.8,R,C,A,S)</l>
<l>    OverlapCounts := [OverlapCounts,|S|]</l>
<l>endfor</l>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l>
<l>dev_display (ParameterImage)</l>
<l>disp_text (WindowHandle,['第4天参数扫描完成','角度范围20/40/60/90：找到=' + AngleFound,'角度范围20/40/60/90：正确=' + AngleCorrect,'返回角度=' + AngleReturned$'.2f','MinScore 0.3/0.5/0.7/0.85：候选数=' + ScoreCounts,'NumLevels 0/1/2/3：10次成功=' + LevelFound10,'NumLevels平均ms=' + LevelTimes$'.2f','Greediness平均ms=' + GreedTimes$'.2f','MaxOverlap候选数=' + OverlapCounts], 'window',12,12,'white',['box_color'],['black'])</l>
<l>clear_shape_model (ModelID)</l>
<l>clear_shape_model (UnmarkedModelID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
