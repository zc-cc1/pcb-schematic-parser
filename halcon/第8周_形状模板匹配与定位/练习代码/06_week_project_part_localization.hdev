<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0"><procedure name="main"><interface/><body>
<c>* 第8周项目：定位零件、让检测ROI跟随，并把所有异常变成明确状态。</c>
<l>dev_update_off ()</l>
<l>dev_close_window ()</l>
<l>read_image (Image,'rings_and_nuts')</l>
<l>get_image_size (Image,Width,Height)</l>
<l>gen_circle (DirectionMark,130,190,12)</l>
<l>paint_region (DirectionMark,Image,MarkedImage,0,'fill')</l>
<l>gen_rectangle1 (TemplateROI,60,60,200,210)</l>
<l>reduce_domain (MarkedImage,TemplateROI,TemplateImage)</l>
<l>create_shape_model (TemplateImage,'auto',rad(-45),rad(90),'auto','auto','use_polarity','auto','auto',ModelID)</l>
<c>* 保存默认中心，随后把模型原点移到检测ROI中心。</c>
<l>find_shape_model (MarkedImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,CenterRow,CenterColumn,CenterAngle,CenterScore)</l>
<l>set_shape_model_origin (ModelID,20,85)</l>
<l>find_shape_model (MarkedImage,ModelID,rad(-45),rad(90),0.5,1,0.5,'least_squares',0,0.8,RefRow,RefColumn,RefAngle,RefScore)</l>
<l>gen_rectangle2 (InspectionROI,RefRow,RefColumn,RefAngle,32,18)</l>
<l>area_center (InspectionROI,ReferenceROIArea,DummyRow,DummyColumn)</l>
<c>* 12个验收样例：前6个正常，第7无目标，第8重遮挡，第9多目标，第10越界，第11低分，第12伪目标。</c>
<l>CaseStatus := []</l>
<l>CaseScores := []</l>
<l>for CaseIndex := 0 to 11 by 1</l>
<l>    hom_mat2d_identity (CaseMove)</l>
<l>    if (CaseIndex &lt;= 5)</l>
<l>        hom_mat2d_rotate (CaseMove,rad((CaseIndex-3)*7),CenterRow,CenterColumn,CaseMove)</l>
<l>        hom_mat2d_translate (CaseMove,(CaseIndex%3-1)*8,(CaseIndex%4-2)*9,CaseMove)</l>
<l>        affine_trans_image (MarkedImage,CaseImage,CaseMove,'constant','false')</l>
<l>        NumToFind := 1</l>
<l>    elseif (CaseIndex == 6)</l>
<l>        gen_image_const (CaseImage,'byte',Width,Height)</l>
<l>        NumToFind := 1</l>
<l>    elseif (CaseIndex == 7)</l>
<l>        affine_trans_image (MarkedImage,CaseImage,CaseMove,'constant','false')</l>
<l>        gen_rectangle1 (HeavyCover,70,70,150,138)</l>
<l>        paint_region (HeavyCover,CaseImage,CaseImage,255,'fill')</l>
<l>        NumToFind := 1</l>
<l>    elseif (CaseIndex == 8)</l>
<l>        affine_trans_image (MarkedImage,CaseImage,CaseMove,'constant','false')</l>
<l>        NumToFind := 5</l>
<l>    elseif (CaseIndex == 9)</l>
<l>        hom_mat2d_translate (CaseMove,0,400,CaseMove)</l>
<l>        affine_trans_image (MarkedImage,CaseImage,CaseMove,'constant','false')</l>
<l>        NumToFind := 1</l>
<l>    elseif (CaseIndex == 10)</l>
<l>        affine_trans_image (MarkedImage,CaseImage,CaseMove,'constant','false')</l>
<l>        gen_rectangle1 (MediumCover,78,72,150,124)</l>
<l>        paint_region (MediumCover,CaseImage,CaseImage,255,'fill')</l>
<l>        NumToFind := 1</l>
<l>    else</l>
<l>        gen_image_const (CaseImage,'byte',Width,Height)</l>
<l>        gen_circle (FakeOuter,250,400,55)</l>
<l>        gen_circle (FakeInner,250,400,31)</l>
<l>        difference (FakeOuter,FakeInner,FakeRing)</l>
<l>        paint_region (FakeRing,CaseImage,CaseImage,0,'fill')</l>
<l>        NumToFind := 1</l>
<l>    endif</l>
<c>* 搜索阈值设为0.25用于保留低分候选；业务合格线单独设为0.80。</c>
<l>    find_shape_model (CaseImage,ModelID,rad(-45),rad(90),0.25,NumToFind,0.5,'least_squares',0,0.8,Row,Column,Angle,Score)</l>
<l>    if (|Score| == 0)</l>
<l>        Status := 'NO_MATCH'</l>
<l>        CaseScores := [CaseScores,0]</l>
<l>    elseif (|Score| &gt; 1)</l>
<l>        Status := 'MULTI_MATCH'</l>
<l>        CaseScores := [CaseScores,Score[0]]</l>
<l>    elseif (Score[0] &lt; 0.8)</l>
<l>        Status := 'LOW_SCORE'</l>
<l>        CaseScores := [CaseScores,Score[0]]</l>
<l>    else</l>
<l>        vector_angle_to_rigid (RefRow,RefColumn,RefAngle,Row[0],Column[0],Angle[0],PoseTransform)</l>
<l>        affine_trans_region (InspectionROI,InspectionROIMoved,PoseTransform,'nearest_neighbor')</l>
<l>        smallest_rectangle1 (InspectionROIMoved,R1,C1,R2,C2)</l>
<l>        area_center (InspectionROIMoved,MovedROIArea,DummyRow,DummyColumn)</l>
<c>* HALCON可能把越界区域裁到图像内，因此同时比较变换前后的ROI面积。</c>
<l>        if (MovedROIArea &lt; ReferenceROIArea*0.99 or R1 &lt; 0 or C1 &lt; 0 or R2 &gt;= Height or C2 &gt;= Width)</l>
<l>            Status := 'ROI_OUT_OF_IMAGE'</l>
<l>        else</l>
<l>            Status := 'OK'</l>
<l>        endif</l>
<l>        CaseScores := [CaseScores,Score[0]]</l>
<l>    endif</l>
<l>    CaseStatus := [CaseStatus,Status]</l>
<l>endfor</l>
<c>* 重新构造越界案例，作为最终可视化。</c>
<l>hom_mat2d_identity (OutMove)</l>
<l>hom_mat2d_translate (OutMove,0,400,OutMove)</l>
<l>affine_trans_image (MarkedImage,OutImage,OutMove,'constant','false')</l>
<l>find_shape_model (OutImage,ModelID,rad(-45),rad(90),0.25,1,0.5,'least_squares',0,0.8,OutRow,OutColumn,OutAngle,OutScore)</l>
<l>vector_angle_to_rigid (RefRow,RefColumn,RefAngle,OutRow[0],OutColumn[0],OutAngle[0],OutPose)</l>
<l>affine_trans_region (InspectionROI,OutROI,OutPose,'nearest_neighbor')</l>
<l>dev_open_window (0,0,Width,Height,'black',WindowHandle)</l>
<l>dev_display (OutImage)</l>
<l>dev_set_draw ('margin')</l>
<l>dev_set_line_width (3)</l>
<l>dev_set_color ('red')</l>
<l>dev_display (OutROI)</l>
<l>disp_text (WindowHandle,['第6天周项目完成','样例1至12状态=' + CaseStatus,'样例1至12分数=' + CaseScores$'.3f','红色ROI在右边界被截断','结论：定位成功不等于质量合格'], 'window',12,12,'white',['box_color'],['black'])</l>
<l>clear_shape_model (ModelID)</l>
</body><docu id="main"><parameters/></docu></procedure></hdevelop>
