{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "basics",
      "displayName": "第一周：纯C++（不需要OpenCV）",
      "description": "Use MSYS2 UCRT64 GCC and project-local Ninja; build outside the Chinese source path.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../.build/week01-basics",
      "environment": { "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/../../.tools/ninja/bin/ninja.exe",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WEEK01_WITH_OPENCV": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "basics", "configurePreset": "basics", "targets": ["basics"] }
  ],
  "testPresets": [
    { "name": "basics", "configurePreset": "basics", "output": { "outputOnFailure": true } }
  ]
}
