{
  "version": "network-labels-v1-development",
  "base_graph": "wire_graph_v1",
  "min_ocr_confidence": 0.95,
  "spelling_conflict_margin": 0.08,
  "label_component_types": [
    "vbus_in",
    "vbus_out",
    "vbus_bidirectional",
    "net_short"
  ],
  "power_component_types": [
    "vcc",
    "gnd"
  ],
  "symbol_text_max_gap_px": 44,
  "symbol_text_tangent_limit_px": 16,
  "endpoint_text_max_gap_px": 18,
  "endpoint_text_tangent_limit_px": 5,
  "endpoint_min_wire_length_px": 12,
  "endpoint_max_tangent_angle_degrees": 25,
  "network_attachment_margin_px": 4,
  "text_role_overlap_iou": 0.3,
  "duplicate_site_distance_px": 12,
  "symbol_evidence_required_for_merge": true,
  "ocr_vote_min_distinct_views": 3,
  "ocr_vote_min_view_lead": 2,
  "net_short_tip_cluster_distance_px": 3,
  "net_short_context_component_max_gap_px": 65,
  "enable_ordinary_label_merges": true,
  "merge_networks_with_unresolved_junctions": false,
  "merge_networks_touching_gap_candidates": false,
  "power_label_merging": false,
  "cross_image_merging": false,
  "fuzzy_label_matching": false,
  "flywire_geometry_policy": "zero_length_label_anchors_provisional",
  "power_name_patterns": [
    "(?:.*_)?(?:GND|VCC|VDD|VSS|VEE|VBUS|VBAT|VIN|VOUT|AVDD|DVDD|AVCC|PVDD|AGND|DGND|PGND|SGND)(?:[0-9_.+ -].*)?",
    "[+-]?(?:[0-9]+(?:[._][0-9]+)?V(?:[0-9])?|V[0-9]+(?:P[0-9]+)?)",
    "[+-]V"
  ]
}
