# Reuse the already tested runtime. The build helper verifies that every
# unchanged source/asset hash matches the base image before applying this layer.
ARG BASE_IMAGE=pcb-parser:local-cuda-2d71a26c
FROM ${BASE_IMAGE}
ENV PCB_OUTPUT_FORMAT=target PCB_WORKERS=0
COPY agent.py adapter.py Dockerfile package_manifest.json README.md /submission/
RUN python -m py_compile /submission/agent.py /submission/adapter.py
ENTRYPOINT ["/submission/run.sh"]
