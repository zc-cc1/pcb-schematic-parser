# Build this image BEFORE upload, then submit docker-save tar inside a ZIP.
# A public Python base avoids relying on the competition's private local image.
FROM python:3.12-slim-bookworm

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
WORKDIR /submission
ENV PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg YOLO_AUTOINSTALL=false PCB_DEVICE=auto PCB_OUTPUT_FORMAT=target

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /submission/
ENV PIP_DEFAULT_TIMEOUT=180 PIP_RETRIES=8 PIP_RESUME_RETRIES=12 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
# Keep completed downloads across failed builds without adding the cache to
# the exported image. Modern pip also resumes interrupted large wheel downloads.
RUN --mount=type=cache,id=pcb-pip-linux-py312,target=/root/.cache/pip \
    python -m pip install pip==26.2.1
RUN --mount=type=cache,id=pcb-pip-linux-py312,target=/root/.cache/pip \
    python -m pip install torch==2.10.0 torchvision==0.25.0 \
        --index-url ${TORCH_INDEX_URL}
RUN --mount=type=cache,id=pcb-pip-linux-py312,target=/root/.cache/pip \
    python -m pip install -r /submission/requirements.txt && python -m pip check

COPY . /submission/
RUN chmod +x /submission/run.sh \
    && python -c "from pathlib import Path; import torch, torchvision, rapidocr, sahi, skimage, networkx; from PIL import ImageFont; ImageFont.truetype('/submission/assets/fonts/DejaVuSansMono.ttf',12); assert len(list(Path('/submission/assets/ocr').glob('*.onnx')))==3"
ENTRYPOINT ["/submission/run.sh"]
