{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcb-parser-competition:submission-draft:0.1",
  "title": "Local provisional submission structure",
  "$comment": "Derived from 0803Rev1 illustrated JSON. Not the official validator/evaluator. Confirm Name/components, type enumeration and semantic rules against Golden.",
  "type": "object",
  "required": ["components", "pins", "nets"],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/component"}
    },
    "pins": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "^pin_.+$"},
        "additionalProperties": {"$ref": "#/$defs/pin"}
      }
    },
    "nets": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/net"}
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "component": {
      "type": "object",
      "required": ["type", "Name", "bbox"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "Name": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      },
      "allOf": [{"if": {"properties": {"type": {"enum": ["resistor", "capacitor"]}}, "required": ["type"]}, "then": {"required": ["value"]}}]
    },
    "pin": {
      "type": "object",
      "required": ["pinname", "point"],
      "additionalProperties": false,
      "properties": {"pinname": {"type": "string"}, "point": {"$ref": "#/$defs/point"}}
    },
    "net": {
      "type": "object",
      "required": ["hyperGraph", "edges"],
      "additionalProperties": false,
      "properties": {
        "hyperGraph": {"type": "string", "pattern": "^\\([^()]*\\)$"},
        "edges": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}
        }
      }
    }
  }
}
