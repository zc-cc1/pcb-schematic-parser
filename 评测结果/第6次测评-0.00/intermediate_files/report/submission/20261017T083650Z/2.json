      ],
      "supply": [
        "v",
        "vcc",
        "vdd"
      ]
    },
    "power_rail_identity": "all grounds share GND; supplies share exact value (null/empty -> VCC); ground and supply remain separate; no inference from component key/Name",
    "power_component_match": "ignore key/Name/designator; raw type/value still exact; geometry and symbol counts still scored",
    "weights": {
      "component_f1": 0.3,
      "pin_f1": 0.25,
      "connectivity_f1": 0.35,
      "wire_f1": 0.1
    },
    "prediction_validation": "missing sections score as empty; invalid component/pin/edge records cannot be TP; hypergraph references retained as sets and reference issues reported"
